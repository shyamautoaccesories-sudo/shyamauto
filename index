  .auth-terms a{color:var(--muted);font-weight:600;text-decoration:underline;}
  .account-head{display:flex;align-items:center;gap:14px;margin-top:16px;margin-bottom:22px;}
  .account-avatar{
    width:52px;height:52px;border-radius:50%;background:var(--yellow);color:#fff;
