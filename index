  // "Order these again" -> is order ke saare available items cart me.
  function buyAgain(){
    if(!activeOrder) return;
    const items = activeOrder.items || [];
    let added = 0, skipped = 0;
    items.forEach(it => {
      const p = it.product_id != null ? findProduct(it.product_id) : null;
      if(!p || p.in_stock === false){ skipped++; return; }
      // addToCart(id, btnEl) — variant/qty params nahi hain. Variant us order se
      // match karke select karo, phir qty ke hisaab se utni baar add karo.
      if(Array.isArray(p.variants) && p.variants.length && it.variant){
        const found = p.variants.findIndex(v => v.name === it.variant);
        if(found !== -1) pdpSelectedVariantIndex = found;
      }
      for(let n = Math.max(1, Number(it.qty) || 1); n > 0; n--) addToCart(p.id);
      added++;
    });
    if(!added){ showToast('Ye products ab available nahi hain'); return; }
    showToast(added + ' item' + (added === 1 ? '' : 's') + ' cart me add ho gaye' + (skipped ? ' · ' + skipped + ' skip hue' : ''));
