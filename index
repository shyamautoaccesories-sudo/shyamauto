  /* ---------------------------------------------------------------------
     STOCK NOTE — the same limit the cart/checkout enforces, shown right in
     the product view so the customer sees it before tapping Add to Cart
     instead of only getting a toast afterwards.
     --------------------------------------------------------------------- */
  // Isse zyada stock par product view chup rehta hai — sirf cart/checkout ka
  // limit enforce hota hai.
  var LOW_STOCK_THRESHOLD = 2;

  function pdpAvailableStock(p, v){
    if(v && v.stock != null) return Number(v.stock);
    if(p && p.stock != null) return Number(p.stock);
    return null; // null = no limit tracked
  }

  function renderPdpStockNote(p, v){
    var note = document.getElementById("pdpStockNote");
    var text = document.getElementById("pdpStockNoteText");
    if(!note || !text) return;

    var set = function(kind, html){
      note.className = "pdp-stock-note show " + kind;
      text.innerHTML = html;
    };

    // 1) this exact product (or variant) is out of stock
    if(isProductOutOfStock(p)){
      set("low", "<strong>Out of stock.</strong> Ye product abhi available nahi hai — jab stock wapas aayega tab order kar payenge.");
      return;
    }
    var available = pdpAvailableStock(p, v);
    if(available != null && available <= 0){
      set("low", "<strong>Out of stock.</strong> " + (v ? "Ye option" : "Ye product") + " abhi available nahi hai.");
      return;
    }

    // 2) how many are left — with a "hurry" tone when it is low
    var inCart = 0;
    var key = cartKeyFor(p.id, pdpSelectedVariantIndex);
    if(cart[key]) inCart = cart[key].qty;

    // Sirf TAB dekhao jab stock 2 ya usse kam bache — 2 se zyada par kuch nahi.
    // (Pehle 5 tak "Only N left" dikhta tha, aur 5 se zyada par "N in stock" —
    //  dono hi customer ko bina zaroorat ke hila dete the.)
    if(available != null && available <= LOW_STOCK_THRESHOLD){
      set("warn",
        "<strong>Only " + available + " left</strong> in stock" +
        (v ? " for " + String(v.name) : "") +
        (inCart ? " \u00b7 " + inCart + " already in your cart" : "") +
        ". Order soon.");
      return;
    }

    // Stock theek hai (ya track hi nahi hota) — note chhupa do.
    // Limit tabhi dikhegi jab customer available se zyada add karne ki koshish kare.
    note.className = "pdp-stock-note";
    text.innerHTML = "";
    note.className = "pdp-stock-note";
    text.innerHTML = "";
  }

  function renderPdpMedia(){
