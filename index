  /* =====================================================================
     PRODUCT REVIEWS — verified buyers only (order Delivered ho chuka ho)
     ===================================================================== */
  let allReviews = [];
  let rvfProductId = null, rvfOrderId = null, rvfRating = 0, rvfEditingId = null;
  let rvfImageUrls = [];
  let rvExpanded = {};

  function reviewsFor(pid){
    return allReviews.filter(function(r){ return String(r.product_id) === String(pid); });
  }
  function myReviewFor(pid){
    if(typeof currentUser === 'undefined' || !currentUser) return null;
    return allReviews.find(function(r){
      return String(r.product_id) === String(pid) && r.user_id === currentUser.id;
    }) || null;
  }
  function hasReviewed(pid){ return !!myReviewFor(pid); }

  // Product id number / string / null sab handle karo — warna String() compare
  // chup-chaap fail ho jata hai aur review button kuch nahi karta.
  function sameProductId(a, b){
    if(a == null || b == null) return false;
    var na = Number(a), nb = Number(b);
    if(!isNaN(na) && !isNaN(nb)) return na === nb;
    return String(a).trim() === String(b).trim();
  }

  function orderHasDeliveredProduct(o, pid){
    if(!o) return false;
    var st = String(o.status || '').trim().toLowerCase();
    if(st !== 'delivered') return false;
    return (o.items || []).some(function(it){
      return sameProductId(it && it.product_id, pid);
    });
  }

  // Verified buyer check: the user bought this product and the order is Delivered.
  // Optional ordersList pass karo (fresh fetch ka result) — warna myOrders.
  function canReviewProduct(pid, ordersList){
    if(typeof currentUser === 'undefined' || !currentUser) return false;
    var orders = Array.isArray(ordersList)
      ? ordersList
      : ((typeof myOrders !== 'undefined' && Array.isArray(myOrders)) ? myOrders : []);
    return orders.some(function(o){ return orderHasDeliveredProduct(o, pid); });
  }

  // Review form kholte waqt hamesha taaza orders use karo.
  async function loadOrdersForReview(){
    try{
      var rows = await loadMyOrders();
      if(Array.isArray(rows) && rows.length) myOrders = rows;
    }catch(e){ /* network fail — myOrders jo hai wahi use karo */ }
    return (typeof myOrders !== 'undefined' && Array.isArray(myOrders)) ? myOrders : [];
  }

  function starStr(n){
    n = Math.round(Number(n) || 0);
    if(n < 0) n = 0; if(n > 5) n = 5;
    return '\u2605\u2605\u2605\u2605\u2605'.slice(0, n) + '\u2606\u2606\u2606\u2606\u2606'.slice(0, 5 - n);
  }
  function initialsOf(name){
    var parts = String(name || 'Rider').trim().split(/\s+/).slice(0, 2);
    return parts.map(function(w){ return w[0]; }).join('').toUpperCase() || 'R';
  }
  function relDate(iso){
    var d = new Date(iso);
    var days = Math.floor((Date.now() - d.getTime()) / 86400000);
    if(days <= 0) return 'Today';
    if(days === 1) return 'Yesterday';
    if(days < 30) return days + ' days ago';
    if(days < 365){ var m = Math.floor(days / 30); return m + ' month' + (m === 1 ? '' : 's') + ' ago'; }
    return d.toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
  }
  function escHtml(s){
    var map = { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' };
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return map[c]; });
  }

  function renderPdpReviews(pid){
    var wrap = document.getElementById('pdpReviews');
    if(!wrap) return;
    var list = reviewsFor(pid);
    var mine = myReviewFor(pid);
    var count = list.length;
    var avg = count ? (list.reduce(function(s, r){ return s + Number(r.rating); }, 0) / count) : 0;
    var logged = (typeof currentUser !== 'undefined' && currentUser);

    var head = '';
    if(count){
      var bars = [5,4,3,2,1].map(function(star){
        var n = list.filter(function(r){ return Number(r.rating) === star; }).length;
        var pct = count ? (n / count * 100) : 0;
        return '<div class="rv-bar-row"><span>' + star + '\u2605</span>' +
          '<span class="rv-bar-track"><span class="rv-bar-fill" style="width:' + pct + '%"></span></span>' +
          '<span>' + n + '</span></div>';
      }).join('');
      head = '<div class="rv-head"><div>' +
        '<div class="rv-score">' + avg.toFixed(1) + '</div>' +
        '<div class="rv-head-stars">' + starStr(avg) + '</div>' +
        '<div class="rv-head-count">' + count + ' review' + (count === 1 ? '' : 's') + '</div>' +
        '</div><div class="rv-bars">' + bars + '</div></div>';
    }

    var starIcon = '<svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
    var cta;
    if(!logged){
      cta = '<div class="rv-gate">Log in to write a review. You can review any product you have ordered once it has been delivered.</div>' +
        '<button class="rv-cta" onclick="openReviewLogin()">Login to write a review</button>';
    } else if(mine){
      cta = '<button class="rv-cta" onclick="openReviewForm(' + pid + ', null)">' + starIcon + 'Edit your review</button>';
    } else if(canReviewProduct(pid)){
      cta = '<button class="rv-cta" onclick="openReviewForm(' + pid + ', null)">' + starIcon + 'Write a review</button>';
    } else {
      cta = '<div class="rv-gate">Only verified buyers can review this product. Once you order it and it has been delivered, the review option will appear here.</div>';
    }

    var showAll = !!rvExpanded[pid];
    var visible = showAll ? list : list.slice(0, 3);

    var items = visible.map(function(r){
      var isMine = logged && r.user_id === currentUser.id;
      var h = '<div class="rv-item"><div class="rv-item-top">' +
        '<div class="rv-avatar">' + escHtml(initialsOf(r.user_name)) + '</div>' +
        '<div class="rv-who"><p class="rv-name">' + escHtml(r.user_name || 'Rider') + (isMine ? ' (You)' : '') + '</p>' +
        '<p class="rv-date">' + relDate(r.created_at) + '</p></div>' +
        '<span class="rv-stars">' + starStr(r.rating) + '</span></div>' +
        '<span class="rv-verified">\u2713 VERIFIED PURCHASE</span>';
      if(r.title) h += '<p class="rv-title">' + escHtml(r.title) + '</p>';
      if(r.body) h += '<p class="rv-body">' + escHtml(r.body) + '</p>';
      if(Array.isArray(r.images) && r.images.length){
        var allEnc = encodeURIComponent(JSON.stringify(r.images));
        h += '<div class="rv-imgs">' + r.images.map(function(u){
          return '<img src="' + escHtml(u) + '" loading="lazy" title="Tap to zoom" ' +
                 'onclick="zoomReviewPhoto(\'' + escHtml(u) + '\', \'' + allEnc + '\')">';
        }).join('') + '</div>';
      }
      if(r.admin_reply){
        h += '<div class="rv-reply"><p class="rv-reply-label">Shyam Auto replied</p>' +
             '<p class="rv-reply-text">' + escHtml(r.admin_reply) + '</p></div>';
      }
      if(isMine){
        h += '<div class="rv-mine-actions">' +
             '<button onclick="openReviewForm(' + pid + ', null)">Edit</button>' +
             '<button onclick="deleteMyReview(' + r.id + ')">Delete</button></div>';
      }
      return h + '</div>';
    }).join('');

    var body = count
      ? '<div class="rv-list">' + items + '</div>'
      : '<p class="rv-body">No reviews for this product yet.</p>';
    var more = (!showAll && count > 3)
      ? '<button class="rv-more" onclick="rvExpanded[' + pid + ']=true; renderPdpReviews(' + pid + ')">Show all ' + count + ' reviews</button>'
      : '';

    wrap.innerHTML = '<h4>Ratings &amp; Reviews</h4>' + head + cta + body + more;
  }

