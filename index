  // Badi image par left/right swipe se photo badlo (touch + mouse drag).
  function attachPdpSwipe(el, enabled){
    if(el._swipeBound){ el._swipeEnabled = enabled; return; }
    el._swipeBound = true;
    el._swipeEnabled = enabled;
    var startX = 0, startY = 0, tracking = false, moved = false;
    function down(e){
      if(!el._swipeEnabled) return;
      var pt = e.touches ? e.touches[0] : e;
      startX = pt.clientX; startY = pt.clientY;
      tracking = true; moved = false;
    }
    function move(e){
      if(!tracking) return;
      var pt = e.touches ? e.touches[0] : e;
      var dx = pt.clientX - startX, dy = pt.clientY - startY;
      // Sirf tab swipe maano jab horizontal movement zyada ho — warna page
      // ka normal vertical scroll block ho jayega.
      if(Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)) moved = true;
    }
    function up(e){
      if(!tracking) return;
      tracking = false;
      if(!moved) return;
      var pt = (e.changedTouches && e.changedTouches[0]) ? e.changedTouches[0] : e;
      var dx = pt.clientX - startX;
      if(Math.abs(dx) > 40){
        suppressNextPdpClick = true;
        setTimeout(function(){ suppressNextPdpClick = false; }, 400);
        stepPdpImage(dx < 0 ? 1 : -1);
      }
    }
    el.addEventListener('touchstart', down, { passive: true });
    el.addEventListener('touchmove', move, { passive: true });
    el.addEventListener('touchend', up);
    el.addEventListener('mousedown', down);
    el.addEventListener('mousemove', move);
    el.addEventListener('mouseup', up);
    el.addEventListener('mouseleave', function(){ tracking = false; });
  }

  // Swipe ke turant baad image ka onclick (lightbox) fire na ho.
  var suppressNextPdpClick = false;
  function pdpImageClick(i){
    if(suppressNextPdpClick) return;
    zoomPdpImage(i);
  }

  function stepPdpImage(delta){
    if(pdpImages.length <= 1) return;
    pdpActiveImgIdx = (pdpActiveImgIdx + delta + pdpImages.length) % pdpImages.length;
    renderPdpMedia();
    renderPdpThumbs();
  }
  /* =====================================================================
     IMAGE LIGHTBOX \u2014 pinch-zoom on touch, wheel/buttons on desktop
     ===================================================================== */
  var lbImages = [], lbIndex = 0, lbScale = 1, lbTx = 0, lbTy = 0;
  var LB_MIN = 1, LB_MAX = 4;
  var lbOverlay = document.getElementById("lbOverlay");
  var lbStage = document.getElementById("lbStage");
  var lbImgEl = document.getElementById("lbImg");

  function openLightbox(images, startIndex){
    lbImages = (images || []).filter(Boolean);
    if(!lbImages.length) return;
    lbIndex = Math.max(0, Math.min(startIndex || 0, lbImages.length - 1));
    lbResetTransform();
    lbApply();
    lbOverlay.classList.add("open");
    lockScroll();
  }
  function closeLightbox(){
    lbOverlay.classList.remove("open");
    unlockScroll();
    clearScrollLockIfIdle();
  }
  function lbResetTransform(){ lbScale = 1; lbTx = 0; lbTy = 0; }
  function lbApply(){
    lbImgEl.src = lbImages[lbIndex];
    lbImgEl.style.transform = "translate(" + lbTx + "px," + lbTy + "px) scale(" + lbScale + ")";
    lbStage.classList.toggle("zoomed", lbScale > 1.01);
    var multi = lbImages.length > 1;
    document.getElementById("lbPrev").style.display = multi ? "flex" : "none";
    document.getElementById("lbNext").style.display = multi ? "flex" : "none";
    document.getElementById("lbCount").textContent = multi ? (lbIndex + 1) + " / " + lbImages.length : "";
    document.getElementById("lbZoomIn").disabled = lbScale >= LB_MAX - 0.01;
    document.getElementById("lbZoomOut").disabled = lbScale <= LB_MIN + 0.01;
    var tw = document.getElementById("lbThumbs");
    tw.innerHTML = multi ? lbImages.map(function(u, i){
      return '<button class="lb-thumb ' + (i === lbIndex ? "active" : "") + '" onclick="lbGo(' + i + ')">' +
             '<img src="' + u + '" alt=""></button>';
    }).join("") : "";
  }
  function lbTransformOnly(){
    lbImgEl.style.transform = "translate(" + lbTx + "px," + lbTy + "px) scale(" + lbScale + ")";
    lbStage.classList.toggle("zoomed", lbScale > 1.01);
    document.getElementById("lbZoomIn").disabled = lbScale >= LB_MAX - 0.01;
    document.getElementById("lbZoomOut").disabled = lbScale <= LB_MIN + 0.01;
  }
  function lbGo(i){ lbIndex = i; lbResetTransform(); lbApply(); }
  function lbStep(d){
    if(!lbImages.length) return;
    lbIndex = (lbIndex + d + lbImages.length) % lbImages.length;
    lbResetTransform(); lbApply();
  }
  function lbSetScale(next, cx, cy){
    next = Math.max(LB_MIN, Math.min(LB_MAX, next));
    if(Math.abs(next - lbScale) < 0.001) return;
    lbScale = next;
    if(lbScale <= 1.01){ lbTx = 0; lbTy = 0; }
    lbTransformOnly();
  }
  function lbZoom(dir){ lbSetScale(lbScale + dir * 0.6); }

  if(lbOverlay){
    // wheel zoom (desktop)
    lbStage.addEventListener("wheel", function(e){
      e.preventDefault();
      lbSetScale(lbScale + (e.deltaY < 0 ? 0.25 : -0.25));
    }, { passive: false });
    // double-click / double-tap toggle
    lbStage.addEventListener("dblclick", function(){
      lbSetScale(lbScale > 1.01 ? 1 : 2.4);
    });
    // drag to pan when zoomed (mouse)
    var dragging = false, dsx = 0, dsy = 0, dtx = 0, dty = 0;
    lbStage.addEventListener("pointerdown", function(e){
      if(lbScale <= 1.01) return;
      dragging = true; dsx = e.clientX; dsy = e.clientY; dtx = lbTx; dty = lbTy;
      lbStage.setPointerCapture(e.pointerId);
    });
    lbStage.addEventListener("pointermove", function(e){
      if(!dragging) return;
      lbTx = dtx + (e.clientX - dsx);
      lbTy = dty + (e.clientY - dsy);
      lbTransformOnly();
    });
    lbStage.addEventListener("pointerup", function(){ dragging = false; });
    lbStage.addEventListener("pointercancel", function(){ dragging = false; });
    // pinch zoom (touch)
    var pinchStart = 0, pinchScale0 = 1;
    lbStage.addEventListener("touchstart", function(e){
      if(e.touches.length === 2){
        pinchStart = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,
                                e.touches[0].clientY - e.touches[1].clientY);
        pinchScale0 = lbScale;
      }
    }, { passive: true });
    lbStage.addEventListener("touchmove", function(e){
      if(e.touches.length === 2 && pinchStart){
        e.preventDefault();
        var d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,
                           e.touches[0].clientY - e.touches[1].clientY);
        lbSetScale(pinchScale0 * (d / pinchStart));
      } else if(e.touches.length === 1 && lbScale > 1.01){
        e.preventDefault();
      }
    }, { passive: false });
    lbStage.addEventListener("touchend", function(e){
      if(e.touches.length < 2) pinchStart = 0;
    });
    // click backdrop (not the image) closes
    lbStage.addEventListener("click", function(e){
      if(e.target === lbStage && lbScale <= 1.01) closeLightbox();
    });
    document.addEventListener("keydown", function(e){
