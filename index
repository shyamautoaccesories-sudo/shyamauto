  // Card aur PDP ke beech price mismatch na ho — dono ek hi rule se price nikaalein.
  // Variants hone par base p.price ignore karke variant ka price use karo, warna
  // card "From ₹1" dikhata tha aur PDP/cart ₹4,750.
  function variantPriceList(p){
    if(!p || !Array.isArray(p.variants) || !p.variants.length) return [];
    return p.variants
      .map(v => ({
        variant: v,
        price: Number(v.price != null ? v.price : p.price),
        mrp: v.mrp != null ? Number(v.mrp) : (p.mrp != null ? Number(p.mrp) : null),
        inStock: !(v.stock != null && v.stock <= 0)
      }))
      .filter(x => !isNaN(x.price));
  }
  // "From" ke liye sabse sasta available variant; sab out of stock ho to sabse sasta.
  function displayPriceInfo(p){
    const list = variantPriceList(p);
    if(!list.length){
      return {
        price: Number(p.price) || 0,
        mrp: p.mrp != null ? Number(p.mrp) : null,
        hasVariants: false,
        isRange: false
      };
    }
    const pool = list.filter(x => x.inStock).length ? list.filter(x => x.inStock) : list;
    const cheapest = pool.reduce((a, b) => (b.price < a.price ? b : a), pool[0]);
    const prices = pool.map(x => x.price);
    return {
      price: cheapest.price,
      mrp: cheapest.mrp,
      hasVariants: true,
      isRange: Math.min(...prices) !== Math.max(...prices),
      lowest: Math.min(...prices),
      highest: Math.max(...prices)
    };
  }

  function isProductOutOfStock(p){
    if(!p) return false;
    if(p.in_stock === false) return true;
    if(Array.isArray(p.variants) && p.variants.length){
      return p.variants.every(v => v.stock != null && v.stock <= 0);
    }
    return p.stock != null && p.stock <= 0;
  }
