  async function openReviewForm(pid, orderId){
    if(typeof currentUser === 'undefined' || !currentUser){
      showToast('Please login first'); openReviewLogin(); return;
    }
    // Fresh orders DB se — khaali/purani myOrders par bharosa mat karo.
    var orders = await loadOrdersForReview();
    if(!canReviewProduct(pid, orders)){
      // Reason-specific message, taaki pata chale kya rok raha hai.
      var mine = orders.filter(function(o){
        return (o.items || []).some(function(it){ return sameProductId(it && it.product_id, pid); });
      });
      if(!mine.length){
        showToast('Ye product aapke orders me nahi mila');
      } else if(mine.some(function(o){ return orderHasDeliveredProduct(o, pid); }) === false){
        var st = String(mine[0].status || 'Pending');
        showToast('Review tabhi likh sakte hain jab order Delivered ho — abhi status: ' + st);
      } else {
        showToast('You can only review delivered orders');
