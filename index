  }

  /* My Orders: list aur order detail box ke andar centre */
  /* Order list + detail sheet ki poori width lein — right side khaali na bache */
  #ordersListView,
  #orderDetailView{max-width:none;margin:0;width:100%;box-sizing:border-box;}
  #orderDetailBody{width:100%;}
  .order-tracker-card,
  .order-summary-card,
  .order-info-card,
  .order-product-row,
  .order-placed-strip{width:100%;box-sizing:border-box;}
  /* My Orders sheet desktop: content poori width, tracker steps ek line me */
  @media (min-width:860px){
    #ordersOverlay .pdp-sheet{max-width:720px;}
    #ordersListView,#orderDetailView{max-width:none;}
    .order-tracker-label{font-size:9.5px;white-space:nowrap;}
    .order-tracker-step{padding:0 2px;}
  }
  .acct-addr-card{border:1px solid var(--line);border-radius:11px;padding:12px;margin-bottom:10px;position:relative;}
  .acct-order-card{cursor:pointer;transition:border-color .15s ease,box-shadow .15s ease;}
  .acct-order-card:active{border-color:var(--accent);box-shadow:0 0 0 3px rgba(200,30,30,.08);}
  .acct-addr-card.is-default{border-color:var(--text);}
  .acct-addr-label{display:inline-block;font-size:9.5px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;background:var(--surface-2);border-radius:99px;padding:2px 8px;margin-bottom:6px;}
  .acct-addr-card.is-default .acct-addr-label{background:var(--text);color:#fff;}
  .acct-addr-line{font-size:12px;line-height:1.5;color:var(--muted);margin:0;}
  .acct-addr-name{font-size:12.5px;font-weight:600;color:var(--text);margin:0 0 3px;}
  .acct-addr-actions{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
  .acct-addr-actions button{font-size:11px;padding:5px 11px;border-radius:7px;border:1px solid var(--line);background:transparent;cursor:pointer;font-weight:600;color:var(--text);font-family:inherit;}
  .acct-addr-actions button.danger{color:#dc2626;border-color:#fca5a5;}
  .acct-empty{font-size:12px;color:var(--muted);text-align:center;padding:18px 0;}
  .pdp-wish-btn{
    position:absolute;top:14px;right:14px;width:36px;height:36px;border-radius:50%;
    background:var(--surface);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;z-index:2;
  }
  .pdp-media-wrap{position:relative;}
  .pdp-media img{width:100%;height:100%;object-fit:cover;border-radius:14px;cursor:zoom-in;}
  .pdp-media img:active{opacity:.92;}

  /* ---- PDP action buttons (wishlist + share stacked) ---- */
  .pdp-share-btn{
    position:absolute;top:58px;right:14px;width:36px;height:36px;border-radius:50%;
    background:var(--surface);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;z-index:2;cursor:pointer;padding:0;
  }
  .pdp-share-btn svg{width:17px;height:17px;stroke:var(--muted);fill:none;stroke-width:2;}
  .pdp-share-btn:hover svg{stroke:var(--text);}
  /* The photo opens the zoomable lightbox on tap, so no badge is shown. */
  .pdp-zoom-hint{display:none;}

  /* ---- Share sheet ---- */
  .share-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:12px;margin:16px 0 6px;}
  @media (min-width:860px){
    .share-grid{grid-template-columns:repeat(5,minmax(0,1fr));}
    .share-opt{padding:18px 10px;font-size:12px;}
  }
  .share-opt{
    display:flex;flex-direction:column;align-items:center;gap:7px;padding:14px 6px;
    border:1px solid var(--line);border-radius:12px;background:transparent;cursor:pointer;
    font-size:11px;font-weight:600;color:var(--text);font-family:inherit;
  }
  .share-opt:hover{border-color:var(--text);}
  .share-opt-icon{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
  .share-opt-icon svg{width:18px;height:18px;}
  .share-link-row{display:flex;gap:8px;align-items:center;margin-top:12px;}
  .share-link-row input{
    flex:1;min-width:0;width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:9px;
    font-size:11.5px;font-family:var(--font-mono);background:var(--surface-2);color:var(--muted);
    text-overflow:ellipsis;
  }
  .share-link-row{flex-wrap:nowrap;}
  .share-prod{min-width:0;}
  .share-prod p{overflow:hidden;text-overflow:ellipsis;}
  .share-prod{display:flex;align-items:center;gap:11px;border:1px solid var(--line);border-radius:12px;padding:11px;}
  .share-prod img{width:48px;height:48px;object-fit:cover;border-radius:8px;flex:none;}
  .share-prod p{margin:0;font-size:13px;font-weight:600;line-height:1.35;}
  .share-prod span{font-size:11.5px;color:var(--muted);font-family:var(--font-mono);}

  /* ---- Image lightbox (zoom) ---- */
  .lb-overlay{
    position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.94);
    opacity:0;pointer-events:none;transition:opacity .22s ease;
    display:flex;align-items:center;justify-content:center;flex-direction:column;
  }
  .lb-overlay.open{opacity:1;pointer-events:auto;}
  .lb-stage{
    flex:1;width:100%;overflow:hidden;display:flex;align-items:center;justify-content:center;
    touch-action:none;position:relative;
  }
  .lb-stage img{
    max-width:100%;max-height:100%;object-fit:contain;transform-origin:center center;
    transition:transform .18s ease;user-select:none;-webkit-user-drag:none;cursor:grab;
  }
  .lb-stage.zoomed img{cursor:grab;transition:none;}
  .lb-close{
    position:absolute;top:calc(14px + var(--safe-top,0px));right:14px;width:40px;height:40px;border-radius:50%;
    background:rgba(255,255,255,.14);border:none;display:flex;align-items:center;justify-content:center;
    z-index:3;cursor:pointer;padding:0;
  }
  .lb-close svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2.4;}
  .lb-nav{
    position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;
    background:rgba(255,255,255,.14);border:none;display:flex;align-items:center;justify-content:center;
    z-index:3;cursor:pointer;padding:0;
  }
  .lb-nav svg{width:20px;height:20px;stroke:#fff;fill:none;stroke-width:2.4;}
  .lb-nav.prev{left:12px;} .lb-nav.next{right:12px;}
  .lb-bar{
    display:flex;align-items:center;justify-content:center;gap:14px;
    padding:12px 16px calc(14px + var(--safe-bottom));flex:0 0 auto;
  }
  .lb-zoom-btn{
    width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.14);border:none;
    color:#fff;font-size:19px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;
  }
  .lb-zoom-btn[disabled]{opacity:.35;cursor:not-allowed;}
  .lb-count{color:rgba(255,255,255,.75);font-size:11.5px;font-family:var(--font-mono);min-width:54px;text-align:center;}
  .lb-thumbs{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;padding:0 16px 10px;}
  .lb-thumb{width:44px;height:44px;border-radius:8px;overflow:hidden;border:2px solid transparent;padding:0;background:none;cursor:pointer;}
  .lb-thumb.active{border-color:#fff;}
  .lb-thumb img{width:100%;height:100%;object-fit:cover;display:block;}

  /* ---- Review photo thumbnails are zoomable ---- */
  .rv-imgs img{cursor:zoom-in;}
  .pdp-thumbs{display:flex;gap:8px;overflow-x:auto;margin:10px 0 4px;scrollbar-width:none;}
  .pdp-thumbs::-webkit-scrollbar{display:none;}
  .pdp-thumb{
    flex:0 0 auto;width:52px;height:52px;border-radius:10px;overflow:hidden;
    border:2px solid transparent;padding:0;background:var(--surface-2);
  }
  .pdp-thumb.active{border-color:var(--yellow);}
  .pdp-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  .pdp-wish-btn svg{width:18px;height:18px;stroke:var(--muted);fill:none;stroke-width:2;}
  .pdp-wish-btn.active svg{stroke:var(--red);fill:var(--red);}
  .card-body{padding:10px 10px 12px;display:flex;flex-direction:column;gap:6px;flex:1;}
  .card-cat{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;font-weight:600;}
  .card-name{font-size:12.5px;font-weight:600;line-height:1.25;min-height:31px;}
  .card-variants{font-size:9.5px;color:var(--muted);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:-3px;}
  .plate{
    display:inline-flex;align-items:baseline;gap:4px;
    background:linear-gradient(180deg, #8F2013, var(--yellow));color:#fff;
    border:none;border-radius:7px;padding:4px 8px;align-self:flex-start;
    font-family:var(--font-mono);
    box-shadow:0 3px 6px rgba(184,41,26,0.35), 0 1px 0 rgba(255,255,255,0.4) inset, 0 -2px 4px rgba(90,20,10,0.25) inset;
  }
  .plate .price{font-size:16px;font-weight:800;letter-spacing:-.2px;}
  .plate{padding:7px 13px;}
  .plate .mrp{font-size:12px;}
  .pdp-plate-row .plate .price{font-size:20px;}
  .pdp-plate-row .plate .mrp{font-size:14px;}
  .pdp-plate-row .plate{padding:9px 16px;}
  .plate .mrp{font-size:9.5px;text-decoration:line-through;opacity:0.55;}
  .card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:2px;}
  .rating{font-size:10.5px;color:var(--muted);font-family:var(--font-mono);}
  .add-btn{
    width:30px;height:30px;border-radius:8px;background:var(--surface-2);border:none;
    display:flex;align-items:center;justify-content:center;color:var(--yellow);
    box-shadow:0 1px 3px rgba(23,20,10,0.12);
  }
  .add-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;}
  .add-btn.added{background:var(--yellow);border-color:var(--yellow);color:#fff;}

  /* ---------- Products view (filter + grid) ---------- */
  .filter-bar{position:sticky;top:0;z-index:30;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 16px 10px;}
  .filter-bar-top{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
  .page-title{font-family:var(--font-display);font-size:16px;font-weight:600;}
  .chip-scroll{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px;}
  .chip-scroll::-webkit-scrollbar{display:none;}
  .chip{
    flex:0 0 auto;width:68px;border-radius:10px;border:none;
    color:var(--muted);background:transparent;padding:0 0 6px;
    display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:4px;position:relative;
  }
  .chip-icon-box{width:68px;height:68px;display:flex;align-items:center;justify-content:center;}
  .chip svg{width:34px;height:34px;stroke:currentColor;fill:none;stroke-width:1.8;}
  .chip img{width:56px;height:56px;object-fit:contain;}
  .chip-label{
    font-size:10.5px;font-weight:600;line-height:1.15;color:var(--text);
    max-width:68px;overflow:hidden;text-overflow:ellipsis;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
    text-align:center;white-space:normal;
  }
  .chip.active{color:var(--yellow);}
  .chip.active .chip-label{color:var(--yellow);}
  .chip.active::after{content:'';position:absolute;left:12px;right:12px;bottom:-2px;height:3px;border-radius:2px;background:var(--yellow);}
  .filter-row2{display:flex;align-items:center;justify-content:space-between;margin-top:10px;gap:8px;}
  .result-count{font-size:12px;color:var(--muted);font-family:var(--font-mono);flex:1;min-width:0;}
  .filter-row2-right{display:flex;align-items:center;gap:8px;flex:0 0 auto;}
  .filter-open-btn{
    position:relative;display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;
    border:1px solid var(--line);background:var(--surface);color:var(--text);padding:8px 12px;border-radius:8px;
  }
  .filter-open-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;}
  .filter-open-btn .filter-count-dot{
    position:absolute;top:-5px;right:-5px;min-width:16px;height:16px;padding:0 3px;border-radius:8px;
    background:var(--red);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;
  }

  /* ---------- Quick model/brand chips (below the Filters button) ---------- */
  .model-chip-wrap{display:flex;align-items:center;gap:6px;margin-top:10px;}
  .model-chip-scroll{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;flex:1;min-width:0;padding-bottom:2px;}
  .model-chip-scroll::-webkit-scrollbar{display:none;}
  .model-chip-arrow{display:none;}
  .model-chip{
    flex:0 0 auto;display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:999px;
    border:1px solid var(--line);background:var(--surface);color:var(--text);font-size:12.5px;font-weight:600;
    white-space:nowrap;
  }
  .model-chip .opt-count{font-size:11px;color:var(--muted);font-family:var(--font-mono);}
  .model-chip.active{background:var(--yellow);border-color:var(--yellow);color:#fff;}
  .model-chip.active .opt-count{color:rgba(255,255,255,0.85);}

  /* ---------- Filters drawer (right side sheet, Flipkart/Amazon style) ---------- */
  .filter-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:70;
    opacity:0;pointer-events:none;transition:opacity 0.25s ease;
  }
  .filter-overlay.open{opacity:1;pointer-events:auto;}
  .filter-drawer{
    position:fixed;top:0;right:0;bottom:0;width:88%;max-width:360px;background:var(--surface);
    z-index:71;transform:translateX(100%);transition:transform 0.28s cubic-bezier(.4,0,.2,1);
    display:flex;flex-direction:column;border-left:1px solid var(--line);
  }
  .filter-drawer.open{transform:translateX(0);}
  .filter-head{display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid var(--line);}
  .filter-head h3{font-size:17px;}
  .filter-body{flex:1;overflow-y:auto;padding:4px 16px 16px;}
  .filter-section{padding:16px 0;border-bottom:1px solid var(--line);}
  .filter-section:last-child{border-bottom:none;}
  .filter-section-title{font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.3px;color:var(--muted);margin-bottom:10px;}
  .filter-option{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:13.5px;cursor:pointer;}
  .filter-option input{width:17px;height:17px;accent-color:var(--yellow);flex:0 0 auto;}
  .filter-option .opt-count{margin-left:auto;font-size:11.5px;color:var(--muted);font-family:var(--font-mono);}
  .filter-empty-hint{font-size:12px;color:var(--muted);padding:20px 0;text-align:center;}
  .filter-foot{display:flex;gap:10px;padding:14px 16px;border-top:1px solid var(--line);}
  .filter-foot button{flex:1;padding:13px;border-radius:10px;font-weight:700;font-size:13.5px;}
  .filter-clear-btn{border:1px solid var(--line);background:var(--surface);color:var(--text);}
  .filter-apply-btn{background:var(--yellow);color:#fff;}
  .sort-select{
    background:var(--surface);border:1px solid var(--line);color:var(--text);
    font-size:12px;font-family:var(--font-mono);font-weight:600;padding:8px 10px;border-radius:8px;
  }
  .grid-wrap{padding:16px;}
  .product-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .empty-state{text-align:center;color:var(--muted);font-size:13px;padding:60px 20px;grid-column:1/-1;}

  /* ---------- Bike model selection ---------- */
  .model-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .model-card{
    background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden;text-align:left;
  }
  .model-card-img{
    width:100%;aspect-ratio:4/3;background:var(--surface-2);display:flex;align-items:center;justify-content:center;
    color:var(--muted);font-family:var(--font-mono);font-size:11px;overflow:hidden;
  }
  .model-card-img img{width:100%;height:100%;object-fit:cover;}
  .model-card-name{padding:10px 12px;font-size:13.5px;font-weight:600;}
  .model-card-brand{padding:0 12px 10px;font-size:11px;color:var(--muted);font-family:var(--font-mono);margin-top:-6px;}

  /* ---------- Brands (gear/accessory brands we stock) ---------- */
  .brands{padding:26px 16px 8px;}
  .brands .section-head{margin-bottom:14px;}
  .brands .section-head h3{font-size:13px;color:var(--muted);font-weight:600;text-transform:none;font-family:var(--font-body);}
  .gearbrand-scroll{display:flex;gap:16px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;}
  .gearbrand-scroll::-webkit-scrollbar{display:none;}
  .gearbrand-item{flex:0 0 auto;width:76px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;}
  .gearbrand-logo{
    width:64px;height:64px;border-radius:50%;background:var(--surface);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 2px 6px rgba(23,20,10,0.05);
  }
  .gearbrand-logo img{width:100%;height:100%;object-fit:cover;}
  .gearbrand-logo span{font-family:var(--font-display);font-weight:700;font-size:16px;color:var(--yellow);}
  .gearbrand-item p{font-size:11px;font-weight:600;color:var(--muted);line-height:1.2;}
  .empty-hint-inline{font-size:12px;color:var(--muted);}

  /* ---------- Authorised Brand Certificates (admin upload → storefront) ---------- */
  .certificates{padding:26px 16px 8px;}
  .cert-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;}
  .cert-head h3{font-size:13px;color:var(--muted);font-weight:600;text-transform:none;font-family:var(--font-body);margin:0;}
  .cert-viewall{
    border:none;background:none;color:var(--accent);font-weight:700;font-size:12px;
    cursor:pointer;font-family:inherit;padding:4px 2px;white-space:nowrap;
  }
  .cert-scroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:4px;scroll-snap-type:x mandatory;scrollbar-width:none;}
  .cert-scroll::-webkit-scrollbar{display:none;}
  .cert-item{
    flex:0 0 auto;width:128px;scroll-snap-align:start;position:relative;
    border-radius:16px;overflow:hidden;cursor:zoom-in;display:block;
    background:linear-gradient(150deg, var(--yellow-deep), var(--yellow));
    box-shadow:0 8px 18px -10px rgba(0,100,210,0.45);
    aspect-ratio:128/164;
  }
  .cert-item::before{
    content:'';position:absolute;inset:0;
    background-image:repeating-linear-gradient(115deg, rgba(255,255,255,0.07) 0 14px, transparent 14px 28px);
    pointer-events:none;
  }
  .cert-item img{
    position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);
    width:88%;height:88%;object-fit:contain;
    filter:drop-shadow(0 6px 10px rgba(0,0,0,0.28));
  }
  .cert-item-fallback{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-family:var(--font-display);font-weight:700;color:rgba(255,255,255,0.42);
    font-size:26px;letter-spacing:0.5px;text-transform:uppercase;
  }
  .cert-item-label{
    position:absolute;left:0;right:0;bottom:0;z-index:2;padding:9px 9px 10px;
    background:linear-gradient(0deg, rgba(0,20,50,0.65), transparent 75%);
    color:#fff;font-weight:600;font-size:12px;line-height:1.2;
  }
  .cert-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(128px,1fr));gap:14px;}
  @media (min-width:860px){
    .cert-scroll{flex-wrap:wrap;overflow-x:visible;}
    .cert-item{width:200px;aspect-ratio:200/250;border-radius:20px;}
    .cert-item-fallback{font-size:40px;}
    .cert-item-label{padding:14px;font-size:15px;}
    .certificates{padding-left:40px;padding-right:40px;max-width:1200px;margin:0 auto;}
    .cert-grid{grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:18px;}
  }
  .cert-empty{font-size:12px;color:var(--muted);}

  /* ---------- Testimonials (Google-review style) ---------- */
  .testi-scroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none;}
  .testi-scroll::-webkit-scrollbar{display:none;}
  .testi-card{
    flex:0 0 auto;width:260px;background:var(--surface);border:1px solid var(--line);
    border-radius:14px;padding:16px;
  }
  .testi-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
  .testi-avatar{
    width:36px;height:36px;border-radius:50%;flex:0 0 auto;
    display:flex;align-items:center;justify-content:center;
    font-family:var(--font-display);font-weight:700;font-size:14px;color:#fff;
  }
  .testi-head-info{flex:1;min-width:0;}
  .testi-name{font-size:12.5px;color:var(--text);font-weight:700;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .testi-meta{display:flex;align-items:center;gap:4px;margin-top:2px;}
  .testi-meta-time{font-size:10.5px;color:var(--muted);}
  .testi-meta svg{width:11px;height:11px;flex:0 0 auto;}
  .testi-stars{color:#fbbc04;font-family:var(--font-mono);font-size:12px;margin-bottom:8px;letter-spacing:2px;}
  .testi-text{font-size:12.5px;color:var(--text);line-height:1.5;margin-bottom:10px;}
  .testi-google-tag{display:flex;align-items:center;gap:5px;font-size:10.5px;color:var(--muted);font-weight:600;}
  .testi-google-tag svg{width:13px;height:13px;flex:0 0 auto;}
  .reviews-summary{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:2px;}
  .reviews-summary-score{font-family:var(--font-display);font-weight:700;font-size:22px;color:var(--text);}
  .reviews-summary-stars{color:#fbbc04;font-family:var(--font-mono);font-size:14px;letter-spacing:2px;}
  .reviews-summary-count{font-size:12px;color:var(--muted);}
  .reviews-summary-google{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);font-weight:600;}
  .reviews-summary-google svg{width:16px;height:16px;}

  /* ---------- Footer ---------- */
  footer{
    margin-top:32px;padding:28px 16px 24px;background:var(--surface);border-top:1px solid var(--line);
  }
  .foot-logo{font-family:var(--font-display);font-size:20px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;line-height:1;}
  .foot-logo img{display:block;max-height:36px;width:auto;}
  .foot-logo span{color:var(--yellow);}
  footer p.addr{color:var(--muted);font-size:12.5px;line-height:1.6;margin-bottom:16px;}
  .foot-links{display:flex;flex-direction:column;gap:9px;margin-bottom:18px;}
  .foot-links a{font-size:13px;color:var(--text);}
  .foot-social{display:flex;gap:10px;margin-bottom:18px;}
  .foot-social a{
    width:36px;height:36px;border-radius:9px;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
  }
  .foot-social svg{width:17px;height:17px;stroke:var(--muted);fill:none;stroke-width:1.7;}
  footer .copy{font-size:11px;color:var(--muted);font-family:var(--font-mono);border-top:1px solid var(--line);padding-top:14px;}

  /* ---------- Bottom nav (mobile) ---------- */
  .bottom-nav{
    position:fixed;left:0;right:0;bottom:0;z-index:50;
    display:flex;background:var(--surface);border-top:1px solid var(--line);
    padding:8px 4px calc(8px + var(--safe-bottom));
  }
  .nav-item{
    flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
    color:var(--muted);font-size:10px;font-weight:600;position:relative;
  }
  .nav-item.active{color:var(--yellow);}
  .nav-item svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.8;}
  .nav-icon-wrap{position:relative;display:inline-flex;}
  .nav-badge{
    position:absolute;top:-6px;right:-8px;background:var(--red);color:#fff;
    font-size:9px;font-family:var(--font-mono);font-weight:700;min-width:15px;height:15px;
    padding:0 3px;border-radius:8px;display:flex;align-items:center;justify-content:center;
  }

  /* ---------- Side menu drawer ---------- */
  .menu-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:60;
    opacity:0;pointer-events:none;transition:opacity 0.25s ease;
  }
  .menu-overlay.open{opacity:1;pointer-events:auto;}
  .menu-drawer{
    position:fixed;top:0;left:0;bottom:0;width:84%;max-width:320px;background:var(--surface);
    z-index:61;transform:translateX(-100%);transition:transform 0.28s cubic-bezier(.4,0,.2,1);
    display:flex;flex-direction:column;border-right:1px solid var(--line);
  }
  .menu-drawer.open{transform:translateX(0);}
  .menu-head{
    display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid var(--line);
  }
  .menu-account-row{
    display:flex;align-items:center;gap:12px;width:100%;padding:16px;border-bottom:1px solid var(--line);text-align:left;
  }
  .menu-account-avatar{
    width:42px;height:42px;border-radius:50%;background:var(--surface-2);flex:0 0 auto;
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;color:var(--yellow);
  }
  .menu-account-avatar svg{width:22px;height:22px;stroke:var(--muted);fill:none;stroke-width:1.8;}
  .menu-account-info{flex:1;min-width:0;}
  .menu-account-name{font-size:14px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .menu-account-sub{font-size:11.5px;color:var(--muted);margin-top:2px;}
  .menu-account-row svg:last-child{stroke:var(--muted);flex:0 0 auto;}
  .menu-nav{flex:1;overflow-y:auto;padding:8px;}
  .menu-nav-item{
    display:flex;align-items:center;gap:14px;width:100%;padding:13px 12px;border-radius:10px;
    font-size:14px;font-weight:600;text-align:left;color:var(--text);
  }
  .menu-nav-item:active{background:var(--surface-2);}
  .menu-nav-item svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.8;flex:0 0 auto;}
  .menu-nav-item.danger{color:var(--red);}
  .menu-foot{padding:8px;border-top:1px solid var(--line);}

  /* ---------- Cart drawer ---------- */
  .cart-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:60;
    opacity:0;pointer-events:none;transition:opacity 0.25s ease;
  }
  .cart-overlay.open{opacity:1;pointer-events:auto;}
  .cart-drawer{
    position:fixed;top:0;right:0;bottom:0;width:88%;max-width:380px;background:var(--surface);
    z-index:61;transform:translateX(100%);transition:transform 0.28s cubic-bezier(.4,0,.2,1);
    display:flex;flex-direction:column;border-left:1px solid var(--line);
  }
  .cart-drawer.open{transform:translateX(0);}
  .cart-head{
    display:flex;align-items:center;justify-content:space-between;padding:16px;border-bottom:1px solid var(--line);
  }
  .cart-head h3{font-size:17px;}
  .cart-items{flex:1;overflow-y:auto;padding:12px 16px;}
  .cart-row{display:flex;gap:10px;padding:12px 0;border-bottom:1px solid var(--line);}
  .cart-row-media{
    width:64px;height:64px;border-radius:9px;background:var(--surface-2);
    display:flex;align-items:center;justify-content:center;flex:0 0 auto;overflow:hidden;
  }
  .cart-row-media svg{width:24px;height:24px;stroke:var(--muted);fill:none;stroke-width:1.6;}
  .cart-row-media img{width:100%;height:100%;object-fit:cover;}
  .cart-row-info{flex:1;min-width:0;}
  .cart-row-info p.name{font-size:12.5px;font-weight:600;margin-bottom:4px;}
  .qty-row{display:flex;align-items:center;gap:10px;}
  .qty-btn{
    width:24px;height:24px;border-radius:6px;background:var(--surface-2);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:13px;
  }
  .qty-val{font-family:var(--font-mono);font-size:12.5px;min-width:14px;text-align:center;}
  .cart-row-price{font-family:var(--font-mono);font-size:13px;font-weight:700;color:var(--yellow);white-space:nowrap;}
  .cart-empty{color:var(--muted);font-size:13px;text-align:center;padding:40px 0;}
  .cart-foot{padding:16px;border-top:1px solid var(--line);}
  .cart-total-row{display:flex;justify-content:space-between;font-size:14px;margin-bottom:12px;}
  .cart-total-row strong{font-family:var(--font-mono);color:var(--yellow);font-size:16px;}
  .checkout-btn{
    width:100%;background:var(--yellow);color:#fff;font-weight:700;font-size:14.5px;
    padding:14px;border-radius:10px;
  }

  /* ---------- Product detail modal ---------- */
  .pdp-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:80;
    opacity:0;pointer-events:none;transition:opacity 0.25s ease;
    display:flex;align-items:flex-end;justify-content:center;
  }
  .pdp-overlay.open{opacity:1;pointer-events:auto;}
  .pdp-sheet{
    width:100%;max-width:480px;max-height:88vh;background:var(--surface);
    border-radius:20px 20px 0 0;border:1px solid var(--line);border-bottom:none;
    transform:translateY(100%);transition:transform 0.3s cubic-bezier(.4,0,.2,1);
    display:flex;flex-direction:column;overflow:hidden;
  }
  .pdp-overlay.open .pdp-sheet{transform:translateY(0);}
  .pdp-handle{width:36px;height:4px;background:var(--line);border-radius:3px;margin:10px auto 0;flex:0 0 auto;}
  .pdp-close{
    position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:9px;
    background:var(--surface-2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;
    z-index:2;
  }
  .pdp-close svg{width:16px;height:16px;stroke:var(--text);fill:none;stroke-width:2;}
  .pdp-scroll{overflow-y:auto;padding:0 20px 20px;}
  .pdp-details{display:contents;}

  /* ---------- Header inline search ---------- */
  .topbar-row{display:flex;align-items:center;justify-content:space-between;width:100%;gap:8px;}
  .topbar-search-row{display:none;align-items:center;gap:8px;width:100%;}
  .topbar.search-active .topbar-row{display:none;}
  .topbar.search-active .topbar-search-row{display:flex;}
  .topbar-search-input-wrap{position:relative;flex:1;min-width:0;}
  .topbar-search-input-wrap .search-icon-svg{
    position:absolute;left:12px;top:50%;transform:translateY(-50%);
    width:16px;height:16px;stroke:var(--muted);fill:none;stroke-width:2;pointer-events:none;
  }
  .topbar-search-input-wrap input{
    width:100%;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;
    padding:10px 36px;font-size:14px;color:var(--text);font-family:var(--font-body);
  }
  .topbar-search-input-wrap input:focus{border-color:var(--yellow);background:var(--surface);}
  .topbar-search-input-wrap .search-clear-btn{
    position:absolute;right:6px;top:50%;transform:translateY(-50%);width:26px;height:26px;border-radius:50%;
    background:var(--surface);border:1px solid var(--line);display:none;align-items:center;justify-content:center;
  }
  .topbar-search-input-wrap .search-clear-btn svg{width:12px;height:12px;stroke:var(--muted);fill:none;stroke-width:2.4;}
  .topbar-search-input-wrap .search-clear-btn.show{display:flex;}
  .header-search-backdrop{
    position:fixed;inset:0;background:rgba(0,0,0,0.35);z-index:38;
    opacity:0;pointer-events:none;transition:opacity 0.2s ease;
  }
  .header-search-backdrop.open{opacity:1;pointer-events:auto;}
  .header-search-panel{
    position:fixed;left:0;right:0;z-index:39;background:var(--surface);
    border-bottom:1px solid var(--line);box-shadow:0 16px 28px rgba(23,20,10,0.14);
    overflow-y:auto;opacity:0;pointer-events:none;transform:translateY(-6px);
    transition:opacity 0.2s ease, transform 0.2s ease;
    padding:14px 16px calc(14px + var(--safe-bottom));
  }
  .header-search-panel.open{opacity:1;pointer-events:auto;transform:translateY(0);}
  .header-search-panel .search-hint{font-size:12px;color:var(--muted);margin:2px 0 12px;}
  @media (min-width:860px){
    .header-search-panel{padding:20px 40px;}
    .header-search-panel .product-grid{grid-template-columns:repeat(5,1fr);}
  }

  /* ---------- Search sheet (legacy, unused) ---------- */
  .search-input-row{position:relative;margin-top:16px;margin-bottom:6px;}
  .search-input-row svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:17px;height:17px;stroke:var(--muted);fill:none;stroke-width:2;pointer-events:none;}
  .search-input-row input{
    width:100%;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;
    padding:13px 40px 13px 40px;font-size:14.5px;color:var(--text);font-family:var(--font-body);
  }
  .search-input-row input:focus{border-color:var(--yellow);background:var(--surface);}
  .search-clear-btn{
    position:absolute;right:8px;top:50%;transform:translateY(-50%);width:26px;height:26px;border-radius:50%;
    background:var(--surface);border:1px solid var(--line);display:none;align-items:center;justify-content:center;
  }
  .search-clear-btn svg{width:12px;height:12px;stroke:var(--muted);fill:none;stroke-width:2.4;}
  .search-clear-btn.show{display:flex;}
  .search-hint{font-size:12px;color:var(--muted);margin:14px 0 4px;}
  #searchResultsGrid{margin-top:14px;}

  /* ---------- Info / policy pages ---------- */
  .info-content h3{font-size:14px;font-weight:700;color:var(--text);margin:18px 0 6px;}
  .info-content h3:first-child{margin-top:0;}
  .info-content p{font-size:13px;color:var(--text);line-height:1.65;margin-bottom:10px;}
  .info-content ul{margin:0 0 10px;padding-left:18px;}
  .info-content li{font-size:13px;color:var(--text);line-height:1.65;margin-bottom:6px;}
  .info-content .info-updated{font-size:11px;color:var(--muted);font-family:var(--font-mono);margin-bottom:16px;}
  .info-content a{color:var(--yellow);font-weight:600;}

  /* ---------- Help / Support chat ---------- */
  .chat-fab{
    position:fixed;right:16px;bottom:calc(76px + var(--safe-bottom));z-index:45;
    width:52px;height:52px;border-radius:50%;background:var(--yellow);color:#fff;
    display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(0,0,0,0.28);
    border:none;
  }
  .chat-fab svg{width:23px;height:23px;stroke:#fff;fill:none;stroke-width:2;}
  @media (min-width:860px){ .chat-fab{bottom:24px;} }

  .chat-tabs{display:flex;gap:6px;margin-bottom:16px;background:var(--surface-2);border-radius:10px;padding:4px;}
  .chat-tab{flex:1;text-align:center;padding:9px 6px;font-size:12.5px;font-weight:700;border-radius:8px;color:var(--muted);}
  .chat-tab.active{background:var(--surface);color:var(--text);}

  .chat-bot-msg{
    background:var(--surface-2);border-radius:14px 14px 14px 4px;padding:12px 14px;
    font-size:13px;color:var(--text);line-height:1.5;margin-bottom:14px;max-width:88%;
  }
  .chat-type-chips{display:flex;flex-direction:column;gap:8px;margin-bottom:6px;}
  .chat-chip{
    text-align:left;padding:12px 14px;border:1px solid var(--line);border-radius:12px;
    font-size:13px;font-weight:600;background:var(--surface);color:var(--text);
  }
  .chat-chip.active{border-color:var(--yellow);background:rgba(184,41,26,0.06);color:var(--yellow);}
  .chat-chip{display:flex;align-items:center;gap:10px;}
  .chat-chip svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.8;flex:0 0 auto;}
  .chat-textarea{resize:vertical;min-height:78px;}

  .chat-confirm-icon{
    width:52px;height:52px;border-radius:50%;background:rgba(30,158,92,0.12);color:#1E9E5C;
    display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;margin:0 auto 14px;
  }
  .chat-confirm-title{font-size:15px;font-weight:700;color:var(--text);margin-bottom:6px;}
  .chat-confirm-sub{font-size:12.5px;color:var(--muted);}

  .chat-ticket-row{
    background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px;
    margin-bottom:8px;text-align:left;width:100%;
  }
  .chat-ticket-row-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px;}
  .chat-ticket-id{font-family:var(--font-mono);font-size:11px;color:var(--muted);}
  .chat-ticket-status{font-family:var(--font-mono);font-size:9.5px;font-weight:700;padding:3px 7px;border-radius:5px;text-transform:uppercase;}
  .chat-ticket-status.open{background:rgba(184,41,26,0.12);color:var(--yellow);}
  .chat-ticket-status.progress{background:rgba(214,137,16,0.14);color:#b0700f;}
  .chat-ticket-status.closed{background:rgba(30,158,92,0.12);color:#1E9E5C;}
  .chat-ticket-type{font-size:12.5px;font-weight:700;color:var(--text);margin-bottom:2px;}
  .chat-ticket-snippet{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

  .chat-thread-back{font-size:12.5px;font-weight:700;color:var(--muted);margin-bottom:12px;}
  .chat-thread-messages{display:flex;flex-direction:column;gap:10px;margin:14px 0;}
  .chat-bubble{max-width:82%;padding:10px 13px;border-radius:14px;font-size:13px;line-height:1.5;}
  .chat-bubble.from-customer{align-self:flex-end;background:var(--yellow);color:#fff;border-radius:14px 14px 4px 14px;}
  .chat-bubble.from-admin{align-self:flex-start;background:var(--surface-2);color:var(--text);border-radius:14px 14px 14px 4px;}
  .chat-bubble-time{font-size:10px;opacity:0.7;margin-top:4px;display:block;}
  .chat-order-context{
    background:rgba(184,41,26,0.06);border:1px solid rgba(184,41,26,0.25);border-radius:12px;
    padding:12px 14px;margin-bottom:14px;
  }
  .chat-order-context p.label{font-size:10px;color:var(--yellow);font-weight:700;text-transform:uppercase;letter-spacing:0.4px;margin-bottom:4px;}
  .chat-order-context p.oid{font-family:var(--font-mono);font-size:12.5px;font-weight:700;color:var(--text);margin-bottom:2px;}
  .chat-order-context p.items{font-size:12px;color:var(--muted);}
  .chat-login-gate{text-align:center;padding:30px 10px;}
  .chat-login-gate p{font-size:13px;color:var(--muted);margin-bottom:16px;line-height:1.5;}

  /* ---------- My Orders ---------- */
  .order-row{
    background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;
    margin-bottom:10px;text-align:left;width:100%;
  }
  .order-row-top{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px;}
  .order-row-id{font-family:var(--font-mono);font-size:11.5px;color:var(--muted);}
  .order-status-badge{font-family:var(--font-mono);font-size:9.5px;font-weight:700;padding:3px 8px;border-radius:5px;text-transform:uppercase;}
  .order-status-badge.pending{background:rgba(214,137,16,0.14);color:#b0700f;}
  .order-status-badge.shipped{background:rgba(74,144,226,0.14);color:#3068c2;}
  .order-status-badge.outfordelivery{background:rgba(124,58,237,0.14);color:#7c3aed;}
  .order-status-badge.delivered{background:rgba(30,158,92,0.12);color:#1E9E5C;}
  .order-status-badge.cancelled{background:rgba(184,41,26,0.12);color:var(--yellow-deep);}
  .order-row-items{font-size:13px;color:var(--text);font-weight:600;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .order-row-meta{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:var(--muted);}
  .order-detail-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;}
  .order-detail-id{font-family:var(--font-mono);font-size:13px;font-weight:700;}
  .order-placed-strip{display:flex;align-items:center;gap:8px;background:var(--surface-2);border-radius:10px;padding:9px 12px;margin:10px 0 0;font-size:12px;color:var(--text);}
  .order-placed-strip svg{width:15px;height:15px;stroke:var(--accent);fill:none;stroke-width:2.5;flex:0 0 auto;}
  .order-row-cta{font-size:11px;color:var(--accent);font-weight:700;margin-top:6px;}
  .order-product-row.tappable{cursor:pointer;}
  .order-product-row.tappable:active{opacity:0.72;}
  .order-product-reorder{font-size:11px;color:var(--accent);font-weight:700;margin-top:6px;}
  .order-product-reorder.muted{color:var(--muted);font-weight:500;}
  .buy-again-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-top:14px;padding:13px;border:none;border-radius:12px;background:var(--accent);color:#fff;font-size:14px;font-weight:700;cursor:pointer;}
  .buy-again-btn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;}
  .order-detail-date{font-size:12px;color:var(--muted);margin-top:2px;}
  .order-item-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px;}
  .order-item-row:last-child{border-bottom:none;}
  .order-detail-total{display:flex;align-items:center;justify-content:space-between;padding-top:12px;font-weight:700;font-size:14px;}
  .help-order-btn{
    width:100%;justify-content:center;display:flex;align-items:center;gap:8px;
    background:var(--surface-2);color:var(--text);font-weight:700;font-size:13.5px;
    padding:13px;border-radius:12px;margin-top:20px;border:1px solid var(--line);
  }
  .help-order-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;}
  .cancel-order-btn{
    width:100%;justify-content:center;display:flex;align-items:center;gap:8px;
    background:rgba(184,41,26,0.06);color:var(--yellow-deep);font-weight:700;font-size:13.5px;
    padding:13px;border-radius:12px;margin-top:10px;border:1px solid rgba(184,41,26,0.25);
  }
  .cancel-order-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;}

  /* ---- Amazon-style order tracker ---- */
  .order-tracker-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 14px 14px;margin:14px 0 18px;}
  .order-tracker-eta{font-size:13.5px;font-weight:700;color:var(--text);margin-bottom:16px;}
  .order-tracker-eta .hl{color:#1E9E5C;}
  .order-tracker-eta .eta-estimate-note{font-size:11px;font-weight:600;color:var(--muted);text-transform:none;}
  .order-tracker-steps{display:flex;align-items:flex-start;}
  .order-tracker-step{flex:1;position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;}
  .order-tracker-line{position:absolute;top:12px;left:-50%;width:100%;height:2px;background:var(--line);z-index:0;}
  .order-tracker-step:first-child .order-tracker-line{display:none;}
  .order-tracker-step.filled .order-tracker-line{background:#1E9E5C;}
  .order-tracker-dot{
    width:25px;height:25px;border-radius:50%;background:var(--surface);border:2px solid var(--line);
    display:flex;align-items:center;justify-content:center;position:relative;z-index:1;flex:0 0 auto;
  }
  .order-tracker-dot svg{width:12px;height:12px;stroke:#fff;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;opacity:0;}
  .order-tracker-step.done .order-tracker-dot{background:#1E9E5C;border-color:#1E9E5C;}
  .order-tracker-step.done .order-tracker-dot svg{opacity:1;}
  .order-tracker-step.active .order-tracker-dot{border-color:var(--yellow);background:var(--yellow);box-shadow:0 0 0 4px rgba(184,41,26,0.14);}
  .order-tracker-step.active .order-tracker-dot::after{content:'';width:7px;height:7px;border-radius:50%;background:#fff;}
  .order-tracker-label{font-size:9.5px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.2px;margin-top:8px;line-height:1.35;}
  .order-tracker-step.done .order-tracker-label,.order-tracker-step.active .order-tracker-label{color:var(--text);}
  .order-tracker-cancelled{display:flex;align-items:center;gap:10px;background:rgba(184,41,26,0.06);border:1px solid rgba(184,41,26,0.2);border-radius:12px;padding:12px 14px;font-size:13px;font-weight:700;color:var(--yellow-deep);}
  .order-tracker-cancelled svg{width:18px;height:18px;stroke:var(--yellow-deep);fill:none;stroke-width:2;flex:0 0 auto;}

  .order-section-label{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;margin:18px 0 8px;}
  .order-product-row{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);}
  .order-product-row:last-child{border-bottom:none;padding-bottom:4px;}
  .order-product-thumb{width:58px;height:58px;border-radius:10px;background:var(--surface-2);flex:0 0 auto;overflow:hidden;display:flex;align-items:center;justify-content:center;}
  .order-product-thumb img{width:100%;height:100%;object-fit:cover;}
  .order-product-thumb svg{width:22px;height:22px;stroke:var(--muted);fill:none;stroke-width:1.6;}
  .order-product-info{flex:1;min-width:0;}
  .order-product-name{font-size:13px;font-weight:600;color:var(--text);line-height:1.35;}
  .order-product-variant{font-size:11.5px;color:var(--muted);margin-top:2px;}
  .order-product-meta{display:flex;align-items:center;justify-content:space-between;margin-top:6px;}
  .order-product-qty{font-size:12px;color:var(--muted);}
  .order-product-price{font-size:13px;font-weight:700;color:var(--text);}
  .order-review-btn{
    margin-top:9px;font-size:11px;font-weight:700;color:var(--yellow-deep);border:1px solid rgba(184,41,26,0.3);
    padding:6px 12px;border-radius:8px;background:rgba(184,41,26,0.05);display:inline-flex;align-items:center;gap:5px;
  }
  .order-review-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;}
  .order-review-btn.done{color:#0a7c2f;border-color:rgba(10,124,47,.35);background:rgba(10,124,47,.06);}
  .order-summary-card{background:var(--bg);border-radius:12px;padding:14px;margin-top:6px;}
  .order-summary-row{display:flex;justify-content:space-between;font-size:12.5px;color:var(--muted);padding:3px 0;}
  .order-summary-row.total{font-weight:700;color:var(--text);font-size:14.5px;padding-top:9px;margin-top:7px;border-top:1px dashed var(--line);}
  .order-info-card{display:flex;gap:10px;background:var(--bg);border-radius:12px;padding:12px 14px;margin-top:10px;}
  .order-info-card svg{width:17px;height:17px;stroke:var(--muted);fill:none;stroke-width:1.8;flex:0 0 auto;margin-top:1px;}
  .order-info-card-label{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.3px;margin-bottom:3px;}
  .order-info-card-value{font-size:12.5px;color:var(--text);line-height:1.5;}
  .pdp-media{
    aspect-ratio:1/1;height:auto;margin:16px 0 4px;border-radius:14px;background:var(--surface-2);
    display:flex;align-items:center;justify-content:center;position:relative;
  }
  .pdp-media svg{width:80px;height:80px;stroke:var(--muted);fill:none;stroke-width:1.3;}
  /* Ek image + thumbnail gallery — 2x2 grid hata diya gaya */
  .pdp-media.solo-mode{cursor:grab;touch-action:pan-y;}
  .pdp-media.solo-mode:active{cursor:grabbing;}
  .pdp-nav{
    position:absolute;top:50%;transform:translateY(-50%);
    width:36px;height:36px;border-radius:50%;
    background:rgba(255,255,255,.92);border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;padding:0;z-index:3;
    box-shadow:0 2px 8px rgba(0,0,0,.12);
  }
  .pdp-nav svg{width:17px;height:17px;stroke:var(--text);fill:none;stroke-width:2.4;}
  .pdp-nav.prev{left:10px;}
  .pdp-nav.next{right:10px;}
  .pdp-img-count{
    position:absolute;bottom:12px;left:50%;transform:translateX(-50%);
    background:rgba(0,0,0,.62);color:#fff;font-size:11px;font-weight:600;
    padding:3px 10px;border-radius:99px;z-index:3;letter-spacing:.3px;
  }
  .pdp-cat{font-size:10.5px;color:var(--yellow);text-transform:uppercase;letter-spacing:1px;font-weight:700;margin-top:16px;}
  .pdp-name{font-size:19px;font-weight:600;font-family:var(--font-body);margin-top:6px;line-height:1.3;}
  .pdp-rating{font-family:var(--font-mono);font-size:12px;color:var(--muted);margin-top:6px;}
  /* ---- Product reviews (PDP) ---- */
  .pdp-reviews{border-top:1px solid var(--line);margin-top:18px;padding-top:16px;}
  .pdp-reviews h4{font-family:var(--font-display);font-size:14px;margin:0 0 10px;letter-spacing:.3px;}
  .rv-head{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px;}
  .rv-score{font-family:var(--font-display);font-weight:700;font-size:30px;line-height:1;}
  .rv-head-stars{color:#fbbc04;font-family:var(--font-mono);font-size:15px;letter-spacing:2px;}
  .rv-head-count{font-size:11.5px;color:var(--muted);}
  .rv-bars{flex:1;min-width:160px;display:flex;flex-direction:column;gap:3px;}
  .rv-bar-row{display:flex;align-items:center;gap:7px;font-size:10.5px;color:var(--muted);font-family:var(--font-mono);}
  .rv-bar-track{flex:1;height:5px;background:var(--line);border-radius:99px;overflow:hidden;}
  .rv-bar-fill{height:100%;background:#fbbc04;border-radius:99px;}
  .rv-cta{width:100%;padding:11px;border:1px dashed var(--line);border-radius:10px;background:transparent;font-family:var(--font-display);font-size:12.5px;font-weight:600;cursor:pointer;color:var(--text);display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:14px;}
  .rv-cta:hover{border-color:var(--text);}
  .rv-cta svg{width:15px;height:15px;fill:#fbbc04;stroke:none;}
  .rv-gate{font-size:11.5px;color:var(--muted);background:rgba(0,0,0,.04);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:14px;line-height:1.5;}
  .rv-list{display:flex;flex-direction:column;gap:12px;}
  .rv-item{border:1px solid var(--line);border-radius:10px;padding:12px;}
  .rv-item-top{display:flex;align-items:center;gap:9px;margin-bottom:7px;}
  .rv-avatar{width:30px;height:30px;border-radius:50%;background:var(--text);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;font-family:var(--font-display);flex:none;}
  .rv-who{flex:1;min-width:0;}
  .rv-name{font-size:12.5px;font-weight:600;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .rv-date{font-size:10.5px;color:var(--muted);margin:1px 0 0;}
  .rv-stars{color:#fbbc04;font-family:var(--font-mono);font-size:12px;letter-spacing:1.5px;}
  .rv-verified{display:inline-flex;align-items:center;gap:3px;font-size:9.5px;font-weight:700;letter-spacing:.4px;color:#0a7c2f;background:#e7f6ec;border-radius:99px;padding:2px 7px;margin-top:4px;}
  .rv-title{font-size:12.5px;font-weight:600;margin:6px 0 3px;}
  .rv-body{font-size:12px;line-height:1.55;color:var(--muted);margin:0;white-space:pre-wrap;}
  .rv-imgs{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
  .rv-imgs img{width:58px;height:58px;object-fit:cover;border-radius:7px;border:1px solid var(--line);cursor:pointer;}
  .rv-reply{margin-top:9px;padding:9px 10px;background:rgba(0,0,0,.04);border-radius:8px;border-left:2px solid var(--text);}
  .rv-reply-label{font-size:10px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;margin:0 0 3px;}
  .rv-reply-text{font-size:11.5px;line-height:1.5;color:var(--muted);margin:0;}
  .rv-mine-actions{display:flex;gap:8px;margin-top:9px;}
  .rv-mine-actions button{font-size:11px;padding:5px 11px;border-radius:7px;border:1px solid var(--line);background:transparent;cursor:pointer;font-weight:600;color:var(--text);}
  .rv-more{width:100%;margin-top:12px;padding:9px;border:1px solid var(--line);border-radius:9px;background:transparent;font-size:11.5px;font-weight:600;cursor:pointer;color:var(--text);}
  /* ---- Write-review sheet ---- */
  .rvf-stars{display:flex;gap:6px;justify-content:flex-start;margin:4px 0 6px;}
  .rvf-stars button{background:none;border:none;font-size:32px;line-height:1;cursor:pointer;color:var(--line);padding:0;}
  .rvf-stars button.on{color:#fbbc04;}
  .rvf-hint{text-align:left;font-size:11.5px;color:var(--muted);margin:0 0 16px;min-height:16px;}
  .rvf-prod{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:10px;padding:10px;margin:0 0 16px;max-width:100%;box-sizing:border-box;}
  .rvf-prod img{width:44px;height:44px;object-fit:cover;border-radius:7px;flex:none;}
  .rvf-prod p{margin:0;font-size:12.5px;font-weight:600;line-height:1.35;}
  .rvf-sheet-label{display:block;font-size:11px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--muted);margin:12px 0 5px;}
  .rvf-sheet-input{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:9px;font-size:13px;font-family:inherit;background:transparent;color:var(--text);box-sizing:border-box;}
  /* Review sheet: sab kuch ek hi column me, left-aligned */
  /* Review content box ke andar centre */
  .rvf-sheet-column{max-width:100%;margin:0;width:100%;}
  .rvf-sheet-column .pdp-name{text-align:left;margin-bottom:14px;}
  #rvfImgsPreview,
  #rvfUploadHint{margin-left:0;margin-right:0;}
  @media (min-width:860px){
    .rvf-sheet-column .rvf-imgs-preview{grid-template-columns:repeat(auto-fill,minmax(84px,1fr));}
  }

  /* ---- Review composer: write + attach in one box ---- */
  .rvf-composer{border:1px solid var(--line);border-radius:12px;background:var(--surface);overflow:hidden;margin-bottom:6px;}
  .rvf-composer-input{width:100%;border:none;outline:none;resize:vertical;background:transparent;padding:13px 14px;font-size:13.5px;font-family:inherit;color:var(--text);min-height:96px;box-sizing:border-box;}
  .rvf-composer-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 10px;border-top:1px solid var(--line);background:var(--surface-2);}
  .rvf-attach{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:7px 12px;cursor:pointer;font-size:12px;font-weight:600;font-family:inherit;color:var(--text);}
  .rvf-attach:hover{border-color:var(--text);}
  .rvf-attach svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2;}
  .rvf-attach[disabled]{opacity:.45;cursor:not-allowed;}
  .rvf-composer-count{font-size:11px;color:var(--muted);font-family:var(--font-mono);}
  .rvf-imgs-preview{display:grid;grid-template-columns:repeat(auto-fill,minmax(74px,1fr));gap:8px;margin-top:8px;}
  .rvf-tile{position:relative;aspect-ratio:1;border-radius:9px;overflow:hidden;border:1px solid var(--line);}
  .rvf-tile img{width:100%;height:100%;object-fit:cover;display:block;}
  .rvf-tile-del{position:absolute;top:3px;right:3px;width:20px;height:20px;border:none;border-radius:50%;background:rgba(0,0,0,.65);color:#fff;font-size:13px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;}
  .rvf-tile-main{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.65);color:#fff;font-size:8.5px;font-weight:700;letter-spacing:.4px;text-align:center;padding:2px 0;}
  .rvf-add-tile{aspect-ratio:1;border:1.5px dashed var(--line);border-radius:9px;background:transparent;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;color:var(--muted);font-size:9.5px;font-weight:600;letter-spacing:.3px;padding:0;font-family:inherit;}
  .rvf-add-tile:hover{border-color:var(--text);color:var(--text);}
  .rvf-add-tile svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:2;}
  .rvf-add-tile[disabled]{opacity:.45;cursor:not-allowed;}
  .rvf-upload-hint{font-size:10.5px;color:var(--muted);margin:6px 0 0;line-height:1.45;}
  .pdp-plate-row{display:flex;align-items:center;gap:10px;margin-top:14px;}
  /* Stock-limit / availability notice inside the product view */
  .pdp-stock-note{
    display:none;align-items:flex-start;gap:8px;margin-top:14px;
    padding:9px 11px;border-radius:9px;font-size:11.5px;line-height:1.5;
  }
  .pdp-stock-note.show{display:flex;}
  .pdp-stock-note svg{width:14px;height:14px;flex:0 0 auto;margin-top:1px;fill:none;stroke-width:2;}
  .pdp-stock-note.warn{background:#fff7e6;border:1px solid #f5d99a;color:#8a5a00;}
  .pdp-stock-note.warn svg{stroke:#b8860b;}
  .pdp-stock-note.info{background:rgba(0,0,0,.035);border:1px solid var(--line);color:var(--muted);}
  .pdp-stock-note.info svg{stroke:var(--muted);}
  .pdp-stock-note.low{background:#fdecec;border:1px solid #f3b6b6;color:#8f1d1d;}
  .pdp-stock-note.low svg{stroke:#c0392b;}
  .pdp-stock-note strong{font-weight:700;}
  .pdp-variants{margin-top:16px;}
  .pdp-variants h4{font-size:11.5px;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);font-family:var(--font-body);font-weight:600;margin-bottom:8px;}
  .pdp-variant-chips{display:flex;flex-wrap:wrap;gap:8px;}
  .pdp-variant-chip{
    padding:9px 14px;border-radius:20px;border:1.5px solid var(--line);background:var(--surface);
    font-size:12.5px;font-weight:600;color:var(--text);
  }
  .pdp-variant-chip.active{border-color:var(--yellow);background:rgba(184,41,26,0.08);color:var(--yellow-deep);}
  .pdp-variant-chip.out-of-stock{opacity:0.45;text-decoration:line-through;}
  .card-plate-note{font-size:10.5px;color:var(--muted);font-family:var(--font-mono);margin-top:2px;}
  .cart-row-variant{font-size:11px;color:var(--muted);margin-top:1px;}
  .pdp-desc{margin-top:16px;}
  .pdp-desc h4{font-size:11.5px;text-transform:uppercase;letter-spacing:0.8px;color:var(--muted);font-family:var(--font-body);font-weight:600;margin-bottom:8px;}
  .pdp-desc p{font-size:13.5px;color:var(--text);line-height:1.6;}
  .pdp-specs{margin-top:16px;display:flex;flex-direction:column;gap:8px;}
  .pdp-spec-row{display:flex;justify-content:space-between;font-size:12.5px;padding:8px 0;border-bottom:1px solid var(--line);}
  .pdp-spec-row span:first-child{color:var(--muted);}
  .pdp-spec-row span:last-child{font-family:var(--font-mono);font-weight:600;}
  .pdp-foot{
    flex:0 0 auto;display:flex;align-items:center;gap:12px;padding:14px 20px calc(14px + var(--safe-bottom));
    border-top:1px solid var(--line);background:var(--surface);
  }
  .pdp-qty{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:10px;padding:8px 12px;}
  .pdp-qty button{width:20px;height:20px;font-family:var(--font-mono);font-size:15px;color:var(--yellow);}
  .pdp-qty span{font-family:var(--font-mono);font-size:14px;min-width:16px;text-align:center;}
  .pdp-add-btn{
    flex:1;background:var(--yellow);color:#fff;font-weight:700;font-size:14px;
    padding:14px;border-radius:10px;
  }

  /* ---------- Auth (login / account) ---------- */
  .auth-title{font-size:20px;font-weight:600;font-family:var(--font-body);margin-top:16px;}
  .auth-sub{color:var(--muted);font-size:13px;margin-top:4px;margin-bottom:22px;line-height:1.5;}
  .google-btn{
    width:100%;display:flex;align-items:center;justify-content:center;gap:10px;
    background:var(--surface);border:1px solid var(--line);border-radius:10px;
    padding:13px;font-size:14px;font-weight:600;color:var(--text);
    box-shadow:0 1px 3px rgba(23,20,10,0.08);
  }
  .google-btn:active{background:var(--surface-2);}
  .auth-divider{display:flex;align-items:center;gap:10px;margin:18px 0;}
  .auth-divider::before,.auth-divider::after{content:"";flex:1;height:1px;background:var(--line);}
  .auth-divider span{font-size:11px;color:var(--muted);font-family:var(--font-mono);}
  .auth-label{font-size:12px;color:var(--muted);font-weight:600;margin-bottom:6px;display:block;}
  .auth-input{
    width:100%;background:var(--surface);border:1px solid var(--line);border-radius:10px;
    padding:13px;font-size:14px;color:var(--text);font-family:var(--font-body);
  }
  .auth-input:focus{border-color:var(--yellow);}
  .auth-terms{font-size:11px;color:var(--muted);text-align:center;margin-top:18px;line-height:1.5;}
  textarea.auth-input{resize:vertical;min-height:70px;font-family:var(--font-body);}
  .field-error{color:var(--red);font-size:11.5px;margin-top:6px;display:none;}
  .field-error.show{display:block;}
  .pay-options{display:flex;flex-direction:column;gap:10px;}
  .pay-option{
    display:flex;align-items:center;gap:12px;width:100%;text-align:left;
    background:var(--surface);border:1.5px solid var(--line);border-radius:10px;
    padding:13px;cursor:pointer;
  }
  .pay-option.active{border-color:var(--yellow);background:var(--surface-2);}
  .pay-option input{accent-color:var(--yellow);width:17px;height:17px;flex:0 0 auto;}
  .pay-option-label{font-size:13.5px;font-weight:600;}
  .pay-option-sub{font-size:11.5px;color:var(--muted);margin-top:1px;}
  .pay-option.disabled{opacity:0.5;cursor:not-allowed;background:var(--surface-2);}
  .pay-option-badge{font-size:10px;font-weight:700;color:var(--red);margin-left:6px;text-transform:uppercase;letter-spacing:0.3px;}
  .co-delivery-hint{font-size:11.5px;color:var(--muted);margin:0 0 2px;line-height:1.5;}
  .co-delivery-hint strong{color:var(--text);}
  .co-row{display:flex;gap:10px;}
  .co-row .auth-field{flex:1;min-width:0;}
  .phone-input-row{display:flex;gap:8px;}
  .phone-prefix{
    flex:0 0 auto;display:flex;align-items:center;justify-content:center;width:48px;
    background:var(--surface-2);border:1px solid var(--line);border-radius:10px;
    font-size:14px;font-weight:600;color:var(--text);
  }
  .phone-input-row .auth-input{flex:1;min-width:0;}
  .info-dot{
