  async function onAvatarPicked(input){
    var f = (input.files || [])[0];
    if(!f) return;
    if(typeof currentUser === "undefined" || !currentUser){ input.value = ""; return; }
    showToast("Uploading photo\u2026");
    // the profile photo is compressed too (a little larger target is fine here)
    f = await compressTicketImage(f, 200 * 1024);
    var avPathUid = await requireUserId();
    if(!avPathUid){ showToast("Session expired - please log in again"); return; }
    var path = avPathUid + "/avatar-" + Date.now() + ".jpg";
    var up = await sb.storage.from("avatars").upload(path, f, { upsert: true, contentType: "image/jpeg" });
    input.value = "";
    if(up.error){ showToast("Photo upload failed"); return; }
    var pub = sb.storage.from("avatars").getPublicUrl(path);
    var url = pub && pub.data ? pub.data.publicUrl : null;
    var avPatch = { avatar_url: url, updated_at: new Date().toISOString() };
    var avUid = await requireUserId();
    if(!avUid){ showToast("Session expired - please log in again"); return; }
    var avExisting = await sb.from("profiles").select("id").eq("id", avUid).maybeSingle();
    var avHave = !!(avExisting && avExisting.data && avExisting.data.id);
    var avRes = avHave
      ? await sb.from("profiles").update(avPatch).eq("id", avUid)
      : await sb.from("profiles").insert(Object.assign({ id: avUid }, avPatch));
    if(avRes.error){
      console.error("avatar save failed:", avRes.error);
      showToast(avRes.error.message || "Could not save the photo");
      return;
    }
    if(!myProfile) myProfile = { id: currentUser.id };
    myProfile.avatar_url = url;
    document.getElementById("acctAvatarInner").innerHTML = acctAvatarHtml();
    refreshAccountChrome();
    showToast("Profile photo updated");
  }

  async function saveProfile(){
    var name = document.getElementById("acctFullName").value.trim();
    var phone = document.getElementById("acctPhone").value.trim();
    var btn = document.getElementById("acctSaveBtn");
    btn.disabled = true;

    var patch = {
      full_name: name || null,
      phone: phone || null,
      updated_at: new Date().toISOString()
    };

    // Ask the database whether the row exists BEFORE writing anything.
    // (A blind upsert/insert on an existing id is what produced the
    // "violates row-level security policy" error.)
    var uid = await requireUserId();
    if(!uid){
      btn.disabled = false;
      showToast("Session expired - please log in again");
      return;
    }
    var existing = await sb.from("profiles").select("id").eq("id", uid).maybeSingle();
    var haveRow = !!(existing && existing.data && existing.data.id);

    var res;
    if(haveRow){
      res = await sb.from("profiles").update(patch).eq("id", uid);
    } else {
      res = await sb.from("profiles").insert(Object.assign({ id: uid }, patch));
    }

    if(res.error){
      // Second chance: if the UPDATE matched nothing, the row may have been
      // created by a concurrent call — retry once as an insert/update swap.
      var retry = haveRow
        ? await sb.from("profiles").insert(Object.assign({ id: uid }, patch))
        : await sb.from("profiles").update(patch).eq("id", uid);
      if(retry.error){
        btn.disabled = false;
        console.error("saveProfile failed:", res.error, "| retry:", retry.error);
        showToast(retry.error.message || res.error.message || "Could not save your details");
        return;
      }
    }

    btn.disabled = false;
    myProfile = Object.assign({}, myProfile, { id: uid, full_name: name || null, phone: phone || null });
    document.getElementById("acctName").textContent = name || "Rider";
    var subEl = document.getElementById("acctSub");
    if(subEl) subEl.textContent = currentUser.sub || "";
    refreshAccountChrome();
    showToast("Details saved");
  }

