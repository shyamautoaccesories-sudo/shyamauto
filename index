    wrap.innerHTML = myOrders.map(o => {
      const names = (o.items||[]).map(it => it.name).join(', ');
      const date = new Date(o.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
      const qty = (o.items||[]).reduce((s, it) => s + Number(it.qty || 0), 0);
      const qtyLabel = qty + (qty === 1 ? ' item' : ' items');
      const key = orderKey(o);
      return `
        <button class="order-row" onclick="openOrderDetail('${key}')">
          <div class="order-row-top">
            <span class="order-row-id">#${key}</span>
