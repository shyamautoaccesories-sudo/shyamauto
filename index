          </div>
          <p class="order-row-items">${names}</p>
          <div class="order-row-meta"><span>${date} · ${qtyLabel}</span><span>₹${Number(o.total).toLocaleString('en-IN')}</span></div>
          <div class="order-row-cta">Tap to view full details ›</div>
