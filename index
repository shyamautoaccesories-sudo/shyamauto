  async function sendTicketReply(){
    const input = document.getElementById('chatReplyInput');
    const text = input.value.trim();
    if(!activeTicket) return;
    // A reply may be just a photo, just text, or both.
    if(!text && !tkReplyUrls.length){ showToast("Type a message or attach a photo"); return; }

    var sendBtn = document.getElementById('tkReplySendBtn');
    if(sendBtn) sendBtn.disabled = true;

    const msgText = text || '(photo attached)';
    const { error } = await sb.rpc('add_ticket_message', { p_ticket_id: activeTicket.id, p_text: msgText, p_sender: 'customer' });
    if(error){
      if(sendBtn) sendBtn.disabled = false;
      showToast(error.message);
      return;
    }

    // Save the attached photos on the ticket, with a fresh 15-day expiry.
    if(tkReplyUrls.length){
      var existing = Array.isArray(activeTicket.images) ? activeTicket.images.slice() : [];
      var merged = existing.concat(tkReplyUrls);
      var patch = {
        images: merged,
        images_expire_at: new Date(Date.now() + 15 * 86400000).toISOString()
      };
      var upRes = await sb.from('tickets').update(patch).eq('id', activeTicket.id);
      if(upRes.error){
        if(sendBtn) sendBtn.disabled = false;
        showToast("Message sent, but the photo could not be saved");
        return;
      }
      activeTicket.images = merged;
      activeTicket.images_expire_at = patch.images_expire_at;
    }

    activeTicket.messages = [...(activeTicket.messages||[]), { sender: 'customer', text: msgText, at: new Date().toISOString() }];
    input.value = '';
    resetReplyPhotos();
    renderThreadMessages();
    renderTicketThreadPhotos();
    if(sendBtn) sendBtn.disabled = false;
    showToast("Sent");
  }

  // ---- My Orders ----
  const ordersOverlay = document.getElementById('ordersOverlay');
  let activeOrder = null;

  function orderStatusClass(status){
    if(status === 'Delivered') return 'delivered';
    if(status === 'Out for Delivery') return 'outfordelivery';
    if(status === 'Shipped') return 'shipped';
    if(status === 'Cancelled') return 'cancelled';
    return 'pending';
  }

  const ORDER_TRACK_STEPS = ['Pending','Shipped','Out for Delivery','Delivered'];
  const ORDER_TRACK_LABELS = ['Order Placed','Shipped','Out for Delivery','Delivered'];
  const orderCheckSvg = `<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>`;

  function buildOrderTracker(order){
    if(order.status === 'Cancelled'){
      return `
        <div class="order-tracker-card">
          <div class="order-tracker-cancelled">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            This order was cancelled.
          </div>
        </div>`;
    }
    const idx = Math.max(0, ORDER_TRACK_STEPS.indexOf(order.status));
    const isDelivered = idx === ORDER_TRACK_STEPS.length - 1;
    let eta = '';
    if(isDelivered){
      eta = `<span class="hl">Delivered</span> — hope you're enjoying your gear!`;
    } else {
      // Prefer the real Shiprocket EDD (synced from admin's tracking refresh) over a guess.
      const realEdd = order.shiprocket_edd ? new Date(order.shiprocket_edd) : null;
      const hasRealEdd = realEdd instanceof Date && !isNaN(realEdd.getTime());
      let est;
      if(hasRealEdd){
        est = realEdd;
      } else {
        est = new Date(order.created_at);
        est.setDate(est.getDate() + 5);
      }
      const estStr = est.toLocaleDateString('en-IN', { weekday:'short', day:'numeric', month:'short' });
      eta = hasRealEdd
        ? `Arriving by <span class="hl">${estStr}</span>`
        : `Arriving by <span class="hl">${estStr}</span> <span class="eta-estimate-note">(estimated)</span>`;
    }
    const stepsHtml = ORDER_TRACK_LABELS.map((label, i) => {
      let cls = '';
      if(i < idx) cls = 'done';
      else if(i === idx) cls = isDelivered ? 'done' : 'active';
      const lineCls = i <= idx ? 'filled' : '';
      return `
        <div class="order-tracker-step ${cls}">
          <div class="order-tracker-line ${lineCls}"></div>
          <div class="order-tracker-dot">${cls === 'done' ? orderCheckSvg : ''}</div>
          <div class="order-tracker-label">${label}</div>
        </div>`;
    }).join('');
    return `
      <div class="order-tracker-card">
        <p class="order-tracker-eta">${eta}</p>
        <div class="order-tracker-steps">${stepsHtml}</div>
      </div>`;
  }

  // orders table ka primary key "id" SHAYAD "orderNumber" nahi hai. Detail kholte
  // waqt hum ek fresh row bhi fetch karte hain (stale myOrders list kabhi kabhi
  // realtime update ke baad purani reh jaati hai) — isliye ek normaliser rakho jo
  // id / order_number / orderNumber sab handle kar le.
  function normalizeOrderRow(row){
    if(!row) return null;
    const num = row.orderNumber != null ? row.orderNumber
              : (row.order_number != null ? row.order_number
              : (row.order_no != null ? row.order_no : row.id));
    return { ...row, orderNumber: num };
  }
  function orderKey(o){
    if(!o) return '';
    const v = o.orderNumber != null ? o.orderNumber : o.id;
    return v == null ? '' : String(v);
  }
  function findMyOrder(id){
    const k = String(id);
    return myOrders.find(o => orderKey(o) === k || String(o.id) === k) || null;
  }

  async function loadMyOrders(){
    if(!currentUser) return [];
    const { data: userRes } = await sb.auth.getUser();
    const { data, error } = await sb.from('orders').select('*').eq('user_id', userRes.user.id).order('created_at', { ascending: false });
    if(error){ showToast(error.message); return []; }
    return (data || []).map(normalizeOrderRow);
  }

  // Detail kholne se pehle DB se taaza row — ye wahi fix hai jo "click karne par
  // kuch nahi hota" problem ko poori tarah band karta hai (purani list me order
  // na milne par bhi detail khul jaayegi).
  async function fetchOrderForDetail(id){
    const local = findMyOrder(id);
    if(!currentUser) return local;
    try{
      const { data: userRes } = await sb.auth.getUser();
      if(!userRes || !userRes.user) return local;
      const { data, error } = await sb.from('orders').select('*')
        .eq('user_id', userRes.user.id)
        .or('id.eq.' + id + ',order_number.eq.' + id)
        .limit(1);
      if(error || !data || !data.length) return local;
      return normalizeOrderRow(data[0]);
    }catch(e){ return local; }
  }

  // ---- Realtime sync: reflect admin status changes (e.g. Cancelled) instantly ----
  let ordersRealtimeChannel = null;
  function handleOrderRealtimeChange(payload){
    if(payload.eventType === 'DELETE'){
      const oldId = payload.old && payload.old.id;
      myOrders = myOrders.filter(o => orderKey(o) !== String(oldId));
    } else {
      const updated = payload.new;
      if(!updated) return;
      const fresh = normalizeOrderRow(updated);
      const idx = myOrders.findIndex(o => orderKey(o) === orderKey(fresh));
      if(idx !== -1) myOrders[idx] = { ...myOrders[idx], ...fresh };
      else myOrders.unshift(fresh);
    }
    if(!ordersOverlay.classList.contains('open')) return;
    const detailOpen = document.getElementById('orderDetailView').style.display === 'block';
    if(detailOpen && activeOrder && payload.new && orderKey(activeOrder) === orderKey(normalizeOrderRow(payload.new))){
      openOrderDetail(orderKey(payload.new)); // re-render detail + tracker with the fresh status
    } else {
      renderMyOrdersList();
    }
  }
  async function subscribeOrdersRealtime(){
    if(ordersRealtimeChannel) return;
    const { data: userRes } = await sb.auth.getUser();
    if(!userRes || !userRes.user) return;
    ordersRealtimeChannel = sb.channel('customer-orders-' + userRes.user.id)
      .on('postgres_changes', { event: '*', schema: 'public', table: 'orders', filter: `user_id=eq.${userRes.user.id}` }, handleOrderRealtimeChange)
      .subscribe();
  }
  function unsubscribeOrdersRealtime(){
    if(ordersRealtimeChannel){
      sb.removeChannel(ordersRealtimeChannel);
      ordersRealtimeChannel = null;
    }
  }

  async function openMyOrders(){
    if(!currentUser){
      closeAuth();
      showToast('Login to view your orders');
      setTimeout(openAuth, 0);
      return;
    }
    closeAuth();
    // closeAuth() consumes a history entry via an async history.back().
    // Pushing a new one (for ordersOverlay) in the same tick used to race
    // with it — deferring to the next tick lets the back() settle first.
    setTimeout(async () => {
      document.getElementById('ordersListView').style.display = 'block';
      document.getElementById('orderDetailView').style.display = 'none';
      document.getElementById('ordersList').innerHTML = '<p class="empty-hint">Loading...</p>';
      ordersOverlay.classList.add('open');
      pushOverlayHistory();
      myOrders = await loadMyOrders();
      renderMyOrdersList();
      subscribeOrdersRealtime();
    }, 0);
  }
  function closeMyOrdersFn(){
    const wasOpen = ordersOverlay.classList.contains('open');
    ordersOverlay.classList.remove('open');
    unsubscribeOrdersRealtime();
    if(wasOpen) consumeOverlayHistory();
  }
  document.getElementById('ordersClose').addEventListener('click', closeMyOrdersFn);
  ordersOverlay.addEventListener('click', closeMyOrdersFn);

  // List view visible ho aur usme sirf placeholder pada ho — turant asli list
  // render kar do. Ye wahi safety net hai jo "Loading..." par atakne se bachata hai.
  function ensureOrdersListRendered(){
    const wrap = document.getElementById('ordersList');
    if(!wrap) return;
    const listShown = document.getElementById('ordersListView') &&
      document.getElementById('ordersListView').style.display !== 'none';
