  // The product set for the current page context (category chip / model /
  // brand / section already chosen) — this is what filter options and
  // their counts are computed from, and what the drawer's checkboxes
  // further narrow down.
  function contextProductList(){
    let list = products.slice();
    // Section page par bhi wahi products jo homepage par dikhe
    if(activeSection === 'bestsellers') list = products.filter(p => !!p.home_bestseller);
    else if(activeSection === 'new') list = products.filter(p => !!p.home_new_arrival);
    else if(activeSection === 'sale') list = list.filter(p => p.sale);
    if(activeCat !== 'All') list = list.filter(p => p.cat === activeCat);
    if(activeModel) list = list.filter(p => (p.bike_model_ids || []).includes(activeModel));
    if(activeGearBrand) list = list.filter(p => p.brand === activeGearBrand);
    return list;
  }

  function applyProductFilters(list){
    let out = list;
    if(productFilters.brands.size) out = out.filter(p => p.brand && productFilters.brands.has(p.brand));
    if(productFilters.models.size) out = out.filter(p => (p.bike_model_ids || []).some(id => productFilters.models.has(id)));
    if(productFilters.priceBuckets.size){
      out = out.filter(p => {
        const price = Number(p.price);
        return [...productFilters.priceBuckets].some(key => {
          const b = priceBuckets.find(pb => pb.key === key);
          return b && price >= b.min && price < b.max;
        });
      });
    }
    if(productFilters.minRating) out = out.filter(p => Number(p.rating) >= productFilters.minRating);
    if(productFilters.inStockOnly) out = out.filter(p => !isProductOutOfStock(p));
    return out;
  }

