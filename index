        ${Number(activeOrder.discount_amount || 0) > 0 ? `
        <div class="order-summary-row"><span>Discount${activeOrder.coupon_code ? ` (${activeOrder.coupon_code})` : ''}</span><span>−₹${Number(activeOrder.discount_amount).toLocaleString('en-IN')}</span></div>` : ''}
        <div class="order-summary-row total"><span>Order Total</span><span>₹${Number(activeOrder.total).toLocaleString('en-IN')}</span></div>
