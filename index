  // Downscale + re-encode a picked photo so the stored file stays under ~100KB.
  // Tries progressively smaller dimensions / quality until it fits.
  var RVF_TARGET_BYTES = 100 * 1024;

  function loadImageFile(file){
    return new Promise(function(resolve, reject){
      var url = URL.createObjectURL(file);
      var im = new Image();
      im.onload = function(){ URL.revokeObjectURL(url); resolve(im); };
      im.onerror = function(){ URL.revokeObjectURL(url); reject(new Error("decode failed")); };
      im.src = url;
    });
  }
  function canvasToBlob(canvas, type, quality){
    return new Promise(function(resolve){ canvas.toBlob(resolve, type, quality); });
  }

  // Same routine for review photos, ticket photos and the profile photo.
  async function compressTicketImage(file, targetBytes){
    return compressReviewPhoto(file, targetBytes);
  }

  async function compressReviewPhoto(file, targetBytes){
    if(targetBytes) RVF_TARGET_BYTES = targetBytes;
    var im;
    try { im = await loadImageFile(file); }
    catch(e){ return file; }  // not decodable \u2014 let the upload decide

    var maxEdges = [1280, 1024, 860, 720, 600, 480];
    var qualities = [0.82, 0.7, 0.6, 0.5, 0.42, 0.35];
    var canvas = document.createElement("canvas");
    var ctx2d = canvas.getContext("2d");
    var best = null;

    for(var m = 0; m < maxEdges.length; m++){
      var maxEdge = maxEdges[m];
      var scale = Math.min(1, maxEdge / Math.max(im.width, im.height));
      var w = Math.max(1, Math.round(im.width * scale));
      var h = Math.max(1, Math.round(im.height * scale));
      canvas.width = w; canvas.height = h;
      ctx2d.fillStyle = "#ffffff";
      ctx2d.fillRect(0, 0, w, h);
      ctx2d.drawImage(im, 0, 0, w, h);
      for(var q = 0; q < qualities.length; q++){
        var blob = await canvasToBlob(canvas, "image/jpeg", qualities[q]);
        if(!blob) continue;
        if(!best || blob.size < best.size) best = blob;
        if(blob.size <= RVF_TARGET_BYTES){
          return new File([blob], (file.name || "photo").replace(/\.[^.]+$/, "") + ".jpg", { type: "image/jpeg" });
        }
      }
    }
    // Could not reach the target \u2014 send the smallest version we produced.
    if(best) return new File([best], (file.name || "photo").replace(/\.[^.]+$/, "") + ".jpg", { type: "image/jpeg" });
    return file;
  }

  async function onReviewImagesPicked(input){
    var room = RVF_MAX_PHOTOS - rvfImageUrls.length;
    var files = Array.from(input.files || []).slice(0, Math.max(room, 0));
    if(!files.length){ input.value = ''; return; }
    rvfUploading = true;
    renderRvfImagePreview();
    showToast(files.length > 1 ? 'Compressing &amp; uploading photos\u2026'.replace('&amp;','&') : 'Compressing &amp; uploading photo\u2026'.replace('&amp;','&'));
    for(var i = 0; i < files.length; i++){
      var f = files[i];
      // Auto-compress to <=100KB, so any phone photo uploads fast and stays light.
      f = await compressReviewPhoto(f);
      var rvUid = await requireUserId();
      if(!rvUid){ showToast('Session expired - please log in again'); break; }
      var path = rvUid + '/' + Date.now() + '-' + Math.random().toString(36).slice(2,8) + '.jpg';
      var up = await sb.storage.from('review-images').upload(path, f, { upsert: false, contentType: 'image/jpeg' });
      if(up.error){ showToast('Photo upload failed'); continue; }
      var pub = sb.storage.from('review-images').getPublicUrl(path);
      if(pub && pub.data && pub.data.publicUrl) rvfImageUrls.push(pub.data.publicUrl);
    }
    input.value = '';
    rvfUploading = false;
    renderRvfImagePreview();
  }

