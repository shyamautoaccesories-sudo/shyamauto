        showToast(`Only ${maxQty} in stock — you already have all of it in your cart`); return;
      }
      cart[key] = { id: Number(pdpCurrentId), variantIndex: pdpSelectedVariantIndex, qty: existingQty + canAdd };
      saveCartToStorage();
      renderCart();
      showToast(`Only ${maxQty} in stock — added ${canAdd} to your cart`);
      closeProduct();
      return;
    }
    cart[key] = { id: Number(pdpCurrentId), variantIndex: pdpSelectedVariantIndex, qty: existingQty + pdpQty };
