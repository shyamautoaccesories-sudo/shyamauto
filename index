    display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);
    font-size:10px;font-weight:700;
  }

  /* ---------- Toast ---------- */
  .toast{
    position:fixed;left:50%;bottom:78px;transform:translate(-50%,20px);
    background:var(--surface-2);border:1px solid var(--line);color:var(--text);
    padding:10px 16px;border-radius:10px;font-size:12.5px;font-weight:600;
    display:flex;align-items:center;gap:8px;opacity:0;pointer-events:none;
    transition:all 0.25s ease;z-index:70;white-space:nowrap;
  }
  .toast.show{opacity:1;transform:translate(-50%,0);}
  .toast svg{width:15px;height:15px;stroke:var(--yellow);fill:none;stroke-width:2;}

  /* ---------- Order result popup (Blinkit-style) ---------- */
  .order-result-overlay{
    position:fixed;inset:0;z-index:300;
    background:rgba(20,18,14,0.55);backdrop-filter:blur(3px);
    display:flex;align-items:center;justify-content:center;padding:24px;
    opacity:0;pointer-events:none;transition:opacity 0.25s ease;
  }
  .order-result-overlay.show{opacity:1;pointer-events:auto;}
  .order-result-card{
    background:var(--surface);border-radius:22px;padding:34px 26px 26px;
    width:100%;max-width:300px;text-align:center;
    box-shadow:0 20px 50px rgba(0,0,0,0.28);
    transform:scale(0.8) translateY(6px);opacity:0;
    transition:transform 0.35s cubic-bezier(.34,1.56,.64,1),opacity 0.3s ease;
  }
  .order-result-overlay.show .order-result-card{transform:scale(1) translateY(0);opacity:1;}

  .order-result-icon{position:relative;width:84px;height:84px;margin:0 auto 18px;}
  .order-result-icon svg{position:absolute;inset:0;width:100%;height:100%;}
  .order-result-ring{
    position:absolute;inset:0;border-radius:50%;
    box-shadow:0 0 0 0 rgba(46,167,90,0.35);
  }
  .order-result-icon.success .order-result-ring{animation:orderRipple 1s ease-out 0.15s;}
  .order-result-icon.fail .order-result-ring{box-shadow:0 0 0 0 rgba(184,41,26,0.35);animation:orderRippleFail 1s ease-out 0.15s;}
  @keyframes orderRipple{
    0%{box-shadow:0 0 0 0 rgba(46,167,90,0.4);}
    100%{box-shadow:0 0 0 16px rgba(46,167,90,0);}
  }
  @keyframes orderRippleFail{
    0%{box-shadow:0 0 0 0 rgba(184,41,26,0.4);}
    100%{box-shadow:0 0 0 16px rgba(184,41,26,0);}
  }

  .order-result-circle-bg{fill:none;stroke:var(--surface-2);stroke-width:4;}
  .order-result-circle-progress{
    fill:none;stroke-width:4;stroke-linecap:round;
    stroke-dasharray:226;stroke-dashoffset:226;transform:rotate(-90deg);transform-origin:50% 50%;
  }
  .order-result-icon.success .order-result-circle-progress{stroke:#2EA75A;animation:orderCircleDraw 0.5s ease-out 0.05s forwards;}
  .order-result-icon.fail .order-result-circle-progress{stroke:var(--red);animation:orderCircleDraw 0.5s ease-out 0.05s forwards;}
  @keyframes orderCircleDraw{to{stroke-dashoffset:0;}}

  .order-result-check,.order-result-cross{display:none;}
  .order-result-check-path{
    fill:none;stroke:#2EA75A;stroke-width:4.5;stroke-linecap:round;stroke-linejoin:round;
    stroke-dasharray:36;stroke-dashoffset:36;
  }
  .order-result-cross-path1,.order-result-cross-path2{
    fill:none;stroke:var(--red);stroke-width:4.5;stroke-linecap:round;
    stroke-dasharray:29;stroke-dashoffset:29;
  }
  .order-result-icon.success .order-result-check{display:block;}
  .order-result-icon.success .order-result-check-path{animation:orderDraw 0.35s ease-out 0.45s forwards;}
  .order-result-icon.fail .order-result-cross{display:block;}
  .order-result-icon.fail .order-result-cross-path1{animation:orderDraw 0.25s ease-out 0.45s forwards;}
  .order-result-icon.fail .order-result-cross-path2{animation:orderDraw 0.25s ease-out 0.68s forwards;}
  @keyframes orderDraw{to{stroke-dashoffset:0;}}

  .order-result-title{font-family:var(--font-display);font-size:19px;font-weight:600;margin-bottom:6px;text-transform:none;letter-spacing:0.2px;}
  .order-result-sub{color:var(--muted);font-size:13.5px;line-height:1.45;margin-bottom:0;}
  .order-result-card.has-btn .order-result-sub{margin-bottom:18px;}
  .order-result-btn{
    display:none;width:100%;background:var(--yellow);color:#fff;font-weight:700;font-size:14px;
    padding:12px;border-radius:10px;
  }
  .order-result-card.has-btn .order-result-btn{display:block;}
  .order-result-btn:active{background:var(--yellow-deep);}

  /* ---------- Desktop enhancements ---------- */
  @media (min-width:860px){
    body{padding-bottom:0;}
    .bottom-nav{display:none;}
    .topbar{padding:14px 40px;max-width:1200px;margin:0 auto;width:100%;}
    .hero-banner{padding:24px 40px 8px;max-width:1200px;margin:0 auto;}
    .hero-banner-frame{padding-top:38.5%;} /* ~2.6:1 desktop */
    .hero-banner-img.hb-desktop{display:block;}
    .hero-banner-img.hb-mobile{display:none;}
    .hero-shop-btn{top:28px;left:28px;font-size:14.5px;padding:13px 22px;}
    .hero-shop-btn svg{width:15px;height:15px;}
    .hero-carousel-arrow{display:flex;}
    .hero-carousel-dots{margin-top:14px;}
    .hero-dot{width:8px;height:8px;}
    .hero-dot.active{width:24px;}
    section.block,section.brands{padding:40px 40px 8px;max-width:1200px;margin:0 auto;}
    .product-scroll,.testi-scroll{overflow-x:visible;flex-wrap:wrap;}
    .product-scroll .card{width:200px;}
    .carousel-arrows{display:flex;}
    .shop-card{width:200px;height:250px;border-radius:20px;}
    .shop-card-fallback{font-size:44px;}
    .shop-card-label{padding:14px;}
    .shop-card-label span{font-size:15px;}
    .shop-card-label svg{width:16px;height:16px;}
    .gearbrand-scroll{flex-wrap:wrap;overflow-x:visible;}
    .gearbrand-item{width:92px;}
    .gearbrand-logo{width:80px;height:80px;}
    .deal-banner{margin:32px auto 8px;max-width:1200px;}
    footer{padding:40px 40px 28px;max-width:1200px;margin:0 auto;}
    .filter-bar{padding-left:40px;padding-right:40px;max-width:1200px;margin:0 auto;}
    .model-chip-arrow{display:flex;}
    .grid-wrap{padding:20px 40px 40px;max-width:1200px;margin:0 auto;}
    .product-grid{grid-template-columns:repeat(5,1fr);}
    .model-grid{grid-template-columns:repeat(4,1fr);}
  }
  /* ---------- Desktop product view (two-column, like a full product page) ---------- */
  @media (min-width:860px){
    /* The product sheet becomes a wide centred card, like a real product page. */
    .pdp-overlay{align-items:center;}
    .pdp-sheet{
      max-width:1080px;width:calc(100% - 48px);max-height:90vh;
      border-radius:18px;border-bottom:1px solid var(--line);
      transform:translateY(16px) scale(.985);
    }
    .pdp-overlay.open .pdp-sheet{transform:translateY(0) scale(1);}
    .pdp-handle{display:none;}
    .pdp-scroll{padding:28px 32px 24px;}

    /* Two columns: the gallery on the left, details stacked on the right.
       Each side is ONE grid item, so the right column always starts at the
       very top and never lines up with the gallery's last row. */
    .pdp-scroll{
      display:grid;
      grid-template-columns:minmax(0,1fr) minmax(0,0.92fr);
      column-gap:34px;
      align-items:start;
    }
    .pdp-media-wrap{grid-column:1;grid-row:1;width:100%;max-width:520px;margin:0 auto;}
    .pdp-media{margin:0;width:100%;}
    .pdp-thumbs{
      grid-column:1;grid-row:2;margin:12px auto 0;align-self:start;
      width:100%;max-width:520px;justify-content:flex-start;
    }
    .pdp-details{
      grid-column:2;grid-row:1 / span 2;
      display:flex;flex-direction:column;min-width:0;
      position:sticky;top:0;
    }
    .pdp-cat{margin-top:0;}
    .pdp-name{font-size:26px;margin-top:8px;}
    .pdp-rating{margin-top:8px;}
    .pdp-plate-row{margin-top:16px;}
    .pdp-desc{margin-top:18px;}
    .pdp-reviews{border-top:1px solid var(--line);margin-top:22px;}
    .pdp-foot{padding-left:32px;padding-right:32px;}

    /* Ek hi badi image — desktop par bhi phone jaisa. Purana 2x2 grid hata diya,
       isliye grid-mode ko solo ki tarah hi behave karaya gaya hai. */
    .pdp-media.grid-mode,
    .pdp-media.solo-mode{
      aspect-ratio:1/1;height:auto;background:var(--surface-2);
      display:flex;align-items:center;justify-content:center;
      padding:0;align-content:center;
      border-radius:14px;overflow:hidden;
    }
    .pdp-media.grid-mode img,
    .pdp-media.solo-mode img{
      width:100%;height:100%;aspect-ratio:auto;
      object-fit:cover;border-radius:0;background:transparent;
    }
    .pdp-media.grid-mode .badge-sale,
    .pdp-media.grid-mode .badge-oos{top:10px;left:10px;}

    /* action buttons sit in the gallery's top-right corner */
    .pdp-wish-btn{top:12px;right:12px;}
    .pdp-share-btn{top:56px;right:12px;}
    .lb-thumbs{padding-bottom:16px;}
  }

  @media (min-width:1240px){
    .hero-shop-btn{top:32px;left:32px;}
  }
</style>
</head>
