  function renderModelChips(contextList){
    const wrap = document.getElementById('modelChipsWrap');
    const row = document.getElementById('modelChipsRow');
    if(!wrap || !row) return;
    // Hidden on a page already scoped to one model — nothing left to pick.
    if(activeModel){ wrap.style.display = 'none'; row.innerHTML = ''; return; }
    const modelCounts = {};
