    if(Array.isArray(p.variants) && p.variants.length && pdpSelectedVariantIndex == null){
      showToast('Please select an option'); return;
    }
    const v = (pdpSelectedVariantIndex != null && p.variants) ? p.variants[pdpSelectedVariantIndex] : null;
    if(v && v.stock != null && v.stock <= 0){ showToast('This option is out of stock'); return; }
    const maxQty = v ? (v.stock != null ? v.stock : Infinity) : (p.stock != null ? p.stock : Infinity);
    const key = cartKeyFor(pdpCurrentId, pdpSelectedVariantIndex);
    const existingQty = cart[key] ? cart[key].qty : 0;
    if(existingQty + pdpQty > maxQty){
      const canAdd = Math.max(0, maxQty - existingQty);
      const note = document.getElementById('pdpStockNote');
      const noteText = document.getElementById('pdpStockNoteText');
      if(canAdd <= 0){
        if(note && noteText && maxQty !== Infinity){
          note.className = 'pdp-stock-note show warn';
