  function userFromSupabase(u){
    if(!u) return null;
    const name = (u.user_metadata && (u.user_metadata.full_name || u.user_metadata.name)) || u.email || 'Rider';
    const sub = u.email || 'Signed in';
    // The Supabase user id is REQUIRED by every profile / address / photo
    // write. Without it those calls send `undefined` and Postgres rejects
    // the UUID, which is what the app was showing on Save Details.
    return { id: u.id, email: u.email || null, name, sub, initial: name.charAt(0).toUpperCase() };
