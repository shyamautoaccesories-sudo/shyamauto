  // Always resolve a real UUID before writing. Falls back to the live
  // session (and repairs a stale in-memory user) so an undefined id can
  // never reach the database again.
  async function requireUserId(){
    if(currentUser && currentUser.id) return currentUser.id;
    var s = await sb.auth.getSession();
    var u = s && s.data && s.data.session && s.data.session.user;
    if(u && u.id){ currentUser = userFromSupabase(u); return u.id; }
    var g = await sb.auth.getUser();
    var gu = g && g.data && g.data.user;
    if(gu && gu.id){ currentUser = userFromSupabase(gu); return gu.id; }
    return null;
  }

