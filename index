  // ---- Cart state ----
  // Persisted in localStorage so it survives page reloads/redirects
  // (e.g. the Google OAuth login flow navigates away and back).
  const CART_STORAGE_KEY = 'shyamauto_cart';
  function loadCartFromStorage(){
    try{
      const raw = localStorage.getItem(CART_STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : {};
      // Migrate old format (cart[id] = qty number) to new format (cart[key] = {id, variantIndex, qty})
      const migrated = {};
      Object.keys(parsed).forEach(key => {
        const v = parsed[key];
        if(typeof v === 'number'){ migrated[key] = { id: Number(key), variantIndex: null, qty: v }; }
        else if(v && typeof v === 'object'){ migrated[key] = v; }
      });
      return migrated;
    }catch(e){ return {}; }
  }
  function saveCartToStorage(){
    try{ localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart)); }catch(e){}
  }
  let cart = loadCartFromStorage();
  let appliedCoupon = null; // { id, code, type, value, max_discount, discountAmount }
  function cartKeyFor(id, variantIndex){ return variantIndex != null ? `${id}-v${variantIndex}` : `${id}`; }

  function cartLineInfo(key){
    const line = cart[key];
    if(!line) return null;
    const p = findProduct(line.id);
    if(!p) return null;
    const variant = (line.variantIndex != null && Array.isArray(p.variants)) ? p.variants[line.variantIndex] : null;
    const unitPrice = variant ? variant.price : p.price;
    const unitMrp = variant ? variant.mrp : p.mrp;
    const unitDeliveryCharge = Number(p.delivery_charge || 0);
    const unitCodCharge = Number(p.cod_charge || 0);
    return { product: p, variant, unitPrice, unitMrp, unitDeliveryCharge, unitCodCharge, qty: line.qty };
  }

  function keysTotal(){
    return Object.keys(cart).reduce((sum, key) => { const info = cartLineInfo(key); return info ? sum + info.unitPrice * info.qty : sum; }, 0);
  }

  /* ---------------------------------------------------------------------
     DELIVERY CHARGES
     Admin → Settings → Delivery Charges mein pincode-prefix wise rates
     hote hain. Rule: sabse specific (longest) prefix jeetta hai. Final
     charge = zip (zone) aur product charge mein se JO ZYADA HO, kyunki
     bhaari item par product ka charge sahi hota hai, aur door ke pincode
     par zone ka.
     --------------------------------------------------------------------- */
  var deliveryZones = [];

  function deliveryStoreSettings(){
    var st = (typeof site !== "undefined" && site && site.store) ? site.store : {};
    return {
      defaultCharge: Number(st.default_delivery_charge || 0),
      freeAbove: Number(st.free_delivery_above || 0)
    };
  }

  // longest matching prefix wins
  function zoneForPincode(pin){
    var p = String(pin || "").trim();
    if(!/^[0-9]{1,6}$/.test(p)) return null;
    var best = null;
    (deliveryZones || []).forEach(function(z){
      var pre = String(z.prefix || "").trim();
      if(!pre) return;
      if(p.indexOf(pre) === 0){
        if(!best || pre.length > String(best.prefix).length) best = z;
      }
    });
    return best;
  }

  // product charges summed from the cart
  function cartProductDeliveryCharge(){
    return Object.keys(cart).reduce(function(sum, key){
      var info = cartLineInfo(key);
      return info ? sum + info.unitDeliveryCharge * info.qty : sum;
    }, 0);
  }

  // The charge actually applied at checkout.
  function keysDeliveryCharge(){
    var subtotal = keysTotal();
    var productCharge = cartProductDeliveryCharge();
    var st = deliveryStoreSettings();

    // free-delivery threshold (order value based)
    if(st.freeAbove > 0 && subtotal >= st.freeAbove) return 0;

    var pin = "";
    var pinEl = document.getElementById("coPincode");
    if(pinEl) pin = pinEl.value.trim();

    var zone = zoneForPincode(pin);
    var zoneCharge = zone ? Number(zone.charge || 0) : st.defaultCharge;

    // jo zyada ho wahi lagta hai; product ka charge 0 ho to zone ka
    return Math.max(productCharge, zoneCharge);
  }

  // human-readable line for the checkout summary
  function deliveryDescription(){
    var st = deliveryStoreSettings();
    var subtotal = keysTotal();
    if(st.freeAbove > 0 && subtotal >= st.freeAbove) return "Free delivery applied";
    var pinEl = document.getElementById("coPincode");
    var pin = pinEl ? pinEl.value.trim() : "";
    var zone = zoneForPincode(pin);
    if(zone){
      var place = [zone.city, zone.state].filter(Boolean).join(", ");
      return place ? ("To " + place) : ("Pincode " + pin);
    }
    if(/^\d{6}$/.test(pin)) return "Standard delivery";
    return "Enter pincode for exact charge";
  }

  // ---- Cash on Delivery — only offered when EVERY product currently in the
  // cart has COD enabled by the admin. Each product's own COD charge (set
  // in Admin → Products) is summed on top of the normal delivery charge. ----
  function cartCodEligible(){
    const keys = Object.keys(cart);
    if(keys.length === 0) return false;
    return keys.every(key => { const info = cartLineInfo(key); return info && info.product.cod_enabled; });
  }

  function keysCodCharge(){
    return Object.keys(cart).reduce((sum, key) => { const info = cartLineInfo(key); return info ? sum + info.unitCodCharge * info.qty : sum; }, 0);
  }

  // ---- Partial COD — some products can require part of their price to be
  // paid online upfront (fixed ₹ or %), with the rest collected as COD. ----
  function lineCodAdvance(info){
    const p = info.product;
    if(!p.cod_enabled || !p.cod_advance_type) return 0;
    const lineTotal = info.unitPrice * info.qty;
    if(p.cod_advance_type === 'percent'){
      return Math.round(lineTotal * (Number(p.cod_advance_value) || 0) / 100);
    }
    return Math.min(lineTotal, Math.round((Number(p.cod_advance_value) || 0) * info.qty));
  }

  function keysCodAdvance(){
    return Object.keys(cart).reduce((sum, key) => { const info = cartLineInfo(key); return info ? sum + lineCodAdvance(info) : sum; }, 0);
  }

  function selectedPaymentMethod(){
    const el = document.querySelector('input[name="coPayment"]:checked');
    return el ? el.value : 'Online (UPI/Card)';
  }

  // ---------------------------------------------------------------------
  // Coupon codes at checkout — validates a code against the `discounts`
  // table (active, not expired, usage limit, minimum order value) and
  // computes the discount amount for the current cart subtotal.
  // ---------------------------------------------------------------------
  function computeCouponDiscount(d, subtotal){
    let raw = d.type === 'percent' ? (subtotal * Number(d.value) / 100) : Number(d.value);
    if(d.type === 'percent' && d.max_discount != null) raw = Math.min(raw, Number(d.max_discount));
    return Math.round(Math.min(raw, subtotal));
  }

  function renderDeliveryHint(){
    var el = document.getElementById("coDeliveryHint");
    if(!el) return;
    var charge = keysDeliveryCharge();
    var desc = deliveryDescription();
    var st = deliveryStoreSettings();
    if(st.freeAbove > 0 && keysTotal() >= st.freeAbove){
      el.style.display = "block";
      el.innerHTML = "<strong>Free delivery</strong> on this order";
      return;
    }
    el.style.display = "block";
    el.innerHTML = desc + " \u2014 <strong>\u20b9" + charge.toLocaleString("en-IN") + "</strong>";
  }

  function updateCheckoutTotals(){
    const subtotal = keysTotal();
    document.getElementById('checkoutSubtotal').textContent = '₹' + subtotal.toLocaleString('en-IN');

    const discountRow = document.getElementById('checkoutDiscountRow');
    let discount = 0;
    if(appliedCoupon){
      // Re-derive the discount against the current subtotal in case the cart changed while a coupon was applied.
      discount = computeCouponDiscount(appliedCoupon, subtotal);
      appliedCoupon.discountAmount = discount;
      discountRow.style.display = 'flex';
      document.getElementById('checkoutDiscountAmount').textContent = '−₹' + discount.toLocaleString('en-IN');
    } else {
      discountRow.style.display = 'none';
    }

    const total = Math.max(0, subtotal - discount);

    const deliveryCharge = keysDeliveryCharge();
    const deliveryRow = document.getElementById('checkoutDeliveryRow');
    if(deliveryCharge > 0){
      deliveryRow.style.display = 'flex';
      document.getElementById('checkoutDeliveryAmount').textContent = '₹' + deliveryCharge.toLocaleString('en-IN');
    } else {
      deliveryRow.style.display = 'none';
    }

    const isCod = selectedPaymentMethod() === 'Cash on Delivery';
    const codCharge = isCod ? keysCodCharge() : 0;
    const codRow = document.getElementById('checkoutCodRow');
    if(isCod && codCharge > 0){
      codRow.style.display = 'flex';
      document.getElementById('checkoutCodAmount').textContent = '₹' + codCharge.toLocaleString('en-IN');
    } else {
      codRow.style.display = 'none';
    }

    const grandTotal = total + deliveryCharge + codCharge;

    const codRemainingRow = document.getElementById('checkoutCodRemainingRow');
    const advanceAmount = isCod ? Math.min(grandTotal, keysCodAdvance()) : 0;
    const totalLabelEl = document.getElementById('checkoutTotalLabel');
    if(isCod && advanceAmount > 0){
      codRemainingRow.style.display = 'flex';
      document.getElementById('checkoutCodRemainingAmount').textContent = '₹' + (grandTotal - advanceAmount).toLocaleString('en-IN');
      totalLabelEl.textContent = 'Pay Now (Online)';
      document.getElementById('checkoutTotal').textContent = '₹' + advanceAmount.toLocaleString('en-IN');
    } else {
      codRemainingRow.style.display = 'none';
      totalLabelEl.textContent = 'Order Total';
      document.getElementById('checkoutTotal').textContent = '₹' + grandTotal.toLocaleString('en-IN');
    }
    return grandTotal;
  }

  // ---- Show/hide the Cash on Delivery payment option based on whether every
  // item currently in the cart has COD enabled, and keep its subtitle showing
  // the COD charge that will apply. Falls back to Online if COD was selected
  // but is no longer eligible (e.g. cart changed). ----
  function refreshCodOptionUI(){
    const codOption = document.getElementById('payCodOption');
    const eligible = cartCodEligible();
    codOption.style.display = eligible ? 'flex' : 'none';
    if(eligible){
      const codCharge = keysCodCharge();
      const advanceAmount = keysCodAdvance();
      if(advanceAmount > 0){
        const grandTotal = keysTotal() - (appliedCoupon ? appliedCoupon.discountAmount : 0) + keysDeliveryCharge() + codCharge;
        document.getElementById('payCodSub').textContent = `Pay ₹${advanceAmount.toLocaleString('en-IN')} online now, ₹${Math.max(0, grandTotal - advanceAmount).toLocaleString('en-IN')} via Cash on Delivery`;
      } else {
        document.getElementById('payCodSub').textContent = codCharge > 0
          ? `Pay ₹${codCharge.toLocaleString('en-IN')} COD charge + item total on delivery`
          : 'Pay in cash when your order is delivered';
      }
    } else {
      const codRadio = document.querySelector('input[name="coPayment"][value="Cash on Delivery"]');
      if(codRadio && codRadio.checked){
        document.querySelector('input[name="coPayment"][value="Online (UPI/Card)"]').checked = true;
        document.getElementById('payOnlineOption').classList.add('active');
        codOption.classList.remove('active');
      }
    }
  }

  function resetCouponUI(){
    appliedCoupon = null;
    document.getElementById('couponCodeInput').value = '';
    document.getElementById('couponError').textContent = '';
    document.getElementById('couponInputRow').style.display = 'flex';
    document.getElementById('couponAppliedRow').style.display = 'none';
    document.getElementById('couponApplyBtn').disabled = false;
    document.getElementById('couponApplyBtn').textContent = 'Apply';
  }

  async function applyCoupon(){
    const input = document.getElementById('couponCodeInput');
    const errorEl = document.getElementById('couponError');
    const code = input.value.trim().toUpperCase();
    errorEl.textContent = '';
    if(!code){ errorEl.textContent = 'Enter a coupon code.'; return; }

    const btn = document.getElementById('couponApplyBtn');
    btn.disabled = true;
    btn.textContent = 'Checking...';

    const { data, error } = await sb.from('discounts').select('*').ilike('code', code).maybeSingle();

    btn.disabled = false;
    btn.textContent = 'Apply';

    if(error || !data){
      errorEl.textContent = 'Invalid coupon code.';
      return;
    }
    if(!data.active){
      errorEl.textContent = 'This coupon is no longer active.';
      return;
    }
    if(data.expires_at && new Date(data.expires_at) < new Date()){
      errorEl.textContent = 'This coupon has expired.';
      return;
    }
    if(data.usage_limit != null && data.used_count >= data.usage_limit){
      errorEl.textContent = 'This coupon has reached its usage limit.';
      return;
    }
    const subtotal = keysTotal();
    if(data.min_order_value && subtotal < Number(data.min_order_value)){
      errorEl.textContent = `Add ₹${(Number(data.min_order_value) - subtotal).toLocaleString('en-IN')} more to use this coupon.`;
      return;
    }

    const discount = computeCouponDiscount(data, subtotal);
    if(discount <= 0){
      errorEl.textContent = 'This coupon does not apply to your order.';
      return;
    }

    appliedCoupon = { id: data.id, code: data.code, type: data.type, value: data.value, max_discount: data.max_discount, discountAmount: discount };
    document.getElementById('couponInputRow').style.display = 'none';
    document.getElementById('couponAppliedRow').style.display = 'flex';
    document.getElementById('couponAppliedText').textContent = `${data.code} applied — you saved ₹${discount.toLocaleString('en-IN')}`;
    updateCheckoutTotals();
    showToast(`Coupon applied! You saved ₹${discount.toLocaleString('en-IN')}`);
  }

  function removeCoupon(){
    resetCouponUI();
    updateCheckoutTotals();
  }

  function addToCart(id, btnEl){
    const p = findProduct(id);
    if(!p) return;
    if(isProductOutOfStock(p)){ showToast('This product is out of stock'); return; }
    // The + button always adds straight to cart — every category behaves the
    // same way. For variant products (size/colour etc.) we quietly pick the
    // first in-stock variant as the default, same as the detail sheet does;
    // the customer can still open the product to switch variants afterwards.
    let variantIndex = null;
    let variant = null;
    if(Array.isArray(p.variants) && p.variants.length){
      variantIndex = p.variants.findIndex(v => v.stock == null || v.stock > 0);
      if(variantIndex === -1) variantIndex = 0;
      variant = p.variants[variantIndex];
    }
    const key = cartKeyFor(id, variantIndex);
    const maxQty = variant ? (variant.stock != null ? variant.stock : Infinity) : (p.stock != null ? p.stock : Infinity);
    const existingQty = cart[key] ? cart[key].qty : 0;
    if(existingQty >= maxQty){
      showToast(`Only ${maxQty} in stock for this product — you already have all of it in your cart`);
      return;
    }
    cart[key] = { id: Number(id), variantIndex, qty: existingQty + 1 };
    saveCartToStorage();
    renderCart();
    showToast('Added to cart');
    if(btnEl){
      btnEl.classList.add('added');
      setTimeout(()=>btnEl.classList.remove('added'), 500);
    }
  }
  function changeQty(key, delta){
    if(!cart[key]) return;
    if(delta > 0){
      const info = cartLineInfo(key);
      if(info){
        const maxQty = info.variant ? (info.variant.stock != null ? info.variant.stock : Infinity) : (info.product.stock != null ? info.product.stock : Infinity);
        if(cart[key].qty + delta > maxQty){
          showToast(`Only ${maxQty} in stock for this product`);
          return;
        }
      }
    }
    cart[key].qty += delta;
    if(cart[key].qty <= 0) delete cart[key];
    saveCartToStorage();
    renderCart();
  }
  function findProduct(id){ return products.find(p => p.id === Number(id)); }

  // -----------------------------------------------------------------------
  // Live inventory guard — the `products` array is only fetched once on
  // page load, so a customer's browser can hold a stale stock number while
  // other customers (or the admin) are buying/editing stock in parallel.
  // Before we let anyone open checkout or actually place an order, we
  // re-fetch the current stock straight from Supabase for just the items
  // in their cart and reconcile the cart against it. This is what stops
  // "5 in stock but 8 got added across different customers" style overselling
  // on the read side; the actual atomic decrement happens server-side in
  // decrement_stock() (see the RPC call in the payment handler below).
  // -----------------------------------------------------------------------
  async function refreshLiveStock(ids){
    if(!ids.length) return;
    const { data, error } = await sb.from('products').select('id,stock,in_stock,variants').in('id', ids);
    if(error || !data) return; // fail open on read — the RPC decrement is still the real guard
    data.forEach(row => {
      const p = findProduct(row.id);
      if(!p) return;
      p.stock = row.stock != null ? Number(row.stock) : null;
      p.in_stock = row.in_stock != null ? !!row.in_stock : true;
      if(Array.isArray(row.variants)) p.variants = row.variants;
    });
  }

  // Reconciles the current cart against live stock. Trims/removes any line
  // that now exceeds what's actually available and returns a human-readable
  // list of what changed (empty array = cart was already fine).
  function reconcileCartWithStock(){
    const changes = [];
    Object.keys(cart).forEach(key => {
      const info = cartLineInfo(key);
      if(!info){ delete cart[key]; return; }
      const { product: p, variant: v, qty } = info;
      const outOfStock = v ? (p.in_stock === false || (v.stock != null && v.stock <= 0)) : isProductOutOfStock(p);
      const available = v ? (v.stock != null ? v.stock : Infinity) : (p.stock != null ? p.stock : Infinity);
      const label = v ? `${p.name} — ${v.name}` : p.name;
      if(outOfStock){
        changes.push(`${label} is now out of stock and was removed from your cart`);
        delete cart[key];
      } else if(qty > available){
        changes.push(available > 0
          ? `${label} — only ${available} left, quantity updated`
          : `${label} is now out of stock and was removed from your cart`);
        if(available > 0) cart[key].qty = available; else delete cart[key];
      }
    });
    if(changes.length){ saveCartToStorage(); renderCart(); }
    return changes;
  }

  // Product ids currently sitting in the cart (for the live-stock fetch).
  function cartProductIds(){
    return [...new Set(Object.values(cart).map(line => line.id))];
  }

  // ---------------------------------------------------------------------
  // Hero banner carousel — up to 3 auto-scrolling slides, each with its
  // own desktop/mobile image and its own "shop this product" link.
  // Works on both desktop (arrow buttons + hover-to-pause) and mobile
  // (swipe gestures), and autoplay pauses while the user is interacting.
  // ---------------------------------------------------------------------
  let heroBannersData = [];
  let heroSlideIndex = 0;
  let heroAutoplayTimer = null;
  const HERO_AUTOPLAY_MS = 4500;

  function renderHeroCarousel(){
    const heroBannerEl = document.getElementById('heroBanner');
    const track = document.getElementById('heroCarouselTrack');
    const dotsEl = document.getElementById('heroCarouselDots');

    heroBannersData = (site.heroBanners || []).filter(b => b && (b.imageUrl || b.imageMobileUrl));

    if(!heroBannersData.length){
      heroBannerEl.style.display = 'none';
      clearInterval(heroAutoplayTimer);
      return;
    }
    heroBannerEl.style.display = '';

    track.innerHTML = heroBannersData.map((b, i) => {
      const desktopSrc = b.imageUrl || b.imageMobileUrl || '';
      const mobileSrc = b.imageMobileUrl || b.imageUrl || '';
      const cta = (b.ctaPrimary || 'Shop Now').replace(/</g,'&lt;');
      return `<a href="#" class="hero-slide" onclick="onHeroSlideNativeClick(${i});return false;" aria-label="${cta}">
        <div class="hero-banner-frame">
          <img class="hero-banner-img hb-desktop" src="${desktopSrc}" alt="${cta}">
          <img class="hero-banner-img hb-mobile" src="${mobileSrc}" alt="${cta}">
        </div>
        <span class="hero-shop-btn">
          <span>${cta}</span>
          <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2.4"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </a>`;
    }).join('');

    const multi = heroBannersData.length > 1;
    dotsEl.innerHTML = multi
      ? heroBannersData.map((_, i) => `<button class="hero-dot" onclick="goToHeroSlide(${i})" aria-label="Go to banner ${i+1}"></button>`).join('')
      : '';
    document.getElementById('heroPrevBtn').style.display = multi ? '' : 'none';
    document.getElementById('heroNextBtn').style.display = multi ? '' : 'none';

    heroSlideIndex = 0;
    updateHeroCarousel(false);
    startHeroAutoplay();
    initHeroSwipe();
  }

  function updateHeroCarousel(animate){
    const track = document.getElementById('heroCarouselTrack');
    track.style.transition = animate === false ? 'none' : 'transform .5s ease';
    track.style.transform = `translateX(-${heroSlideIndex * 100}%)`;
    document.querySelectorAll('#heroCarouselDots .hero-dot').forEach((d, i) => {
      d.classList.toggle('active', i === heroSlideIndex);
    });
  }

  function goToHeroSlide(i){
    if(!heroBannersData.length) return;
    heroSlideIndex = ((i % heroBannersData.length) + heroBannersData.length) % heroBannersData.length;
    updateHeroCarousel(true);
    startHeroAutoplay();
  }

  function startHeroAutoplay(){
    clearInterval(heroAutoplayTimer);
    if(heroBannersData.length <= 1) return;
    heroAutoplayTimer = setInterval(() => goToHeroSlide(heroSlideIndex + 1), HERO_AUTOPLAY_MS);
  }

  function handleHeroBannerClick(i){
    const b = heroBannersData[i];
    const pid = b && b.productId != null && b.productId !== '' ? Number(b.productId) : null;
    const p = pid != null && !Number.isNaN(pid) ? findProduct(pid) : null;
    if(p){ openProduct(p.id); }
    else { document.getElementById('bestsellers').scrollIntoView({behavior:'smooth'}); }
  }

  // The swipe handler below calls track.setPointerCapture() on pointerdown so
  // dragging feels smooth — but that capture can swallow the native "click"
  // the browser would otherwise fire on the tapped <a class="hero-slide">
  // (especially on touch devices). So a genuine tap is detected and handled
  // manually in endHeroDrag(), and this wrapper (bound to the slide's onclick
  // attribute) is briefly suppressed right after so we never open the
  // product twice if the browser also manages to fire its own click.
  let suppressHeroClick = false;
  function onHeroSlideNativeClick(i){
    if(suppressHeroClick) return;
    handleHeroBannerClick(i);
  }

  function handleDealBtnClick(){
    const deal = site.deal || {};
    if(deal.linkType === 'product' && deal.productId){
      const p = findProduct(deal.productId);
      if(p){ openProduct(p.id); return; }
    } else if(deal.linkType === 'category' && deal.category){
      showProducts('cat', deal.category);
      return;
    }
    document.getElementById('bestsellers').scrollIntoView({behavior:'smooth'});
  }

  let heroSwipeInit = false;
  function initHeroSwipe(){
    if(heroSwipeInit) return; // listeners attached once; track content is re-rendered, not the track itself
    heroSwipeInit = true;
    const carousel = document.getElementById('heroCarousel');
    const track = document.getElementById('heroCarouselTrack');
    let startX = 0, dragX = 0, dragging = false;

    track.addEventListener('pointerdown', (e) => {
      if(!heroBannersData.length) return;
      dragging = true; startX = e.clientX; dragX = 0;
      track.style.transition = 'none';
      clearInterval(heroAutoplayTimer);
      try{ track.setPointerCapture(e.pointerId); }catch(err){}
    });
    track.addEventListener('pointermove', (e) => {
      if(!dragging) return;
      dragX = e.clientX - startX;
      track.style.transform = `translateX(calc(-${heroSlideIndex * 100}% + ${dragX}px))`;
    });
    function endHeroDrag(){
      if(!dragging) return;
      dragging = false;
      track.style.transition = 'transform .5s ease';
      const width = track.clientWidth || 1;
      const threshold = width * 0.15;
      const wasTap = Math.abs(dragX) < 6;
      if(dragX < -threshold) goToHeroSlide(heroSlideIndex + 1);
      else if(dragX > threshold) goToHeroSlide(heroSlideIndex - 1);
      else updateHeroCarousel(true);

      // Barely-moved pointer = a tap, not a swipe — fire the banner's action
      // directly, since setPointerCapture() above can prevent the browser's
      // own click from reaching the <a>. Then briefly suppress that native
      // click (for taps and real drags alike) so we don't double-fire if it
      // does still arrive.
      if(wasTap) handleHeroBannerClick(heroSlideIndex);
      suppressHeroClick = true;
      setTimeout(() => { suppressHeroClick = false; }, 350);

      dragX = 0;
      startHeroAutoplay();
    }
    track.addEventListener('pointerup', endHeroDrag);
    track.addEventListener('pointercancel', endHeroDrag);
    track.addEventListener('pointerleave', () => { if(dragging) endHeroDrag(); });

    // Pause autoplay while the pointer hovers the carousel on desktop.
    carousel.addEventListener('mouseenter', () => clearInterval(heroAutoplayTimer));
    carousel.addEventListener('mouseleave', () => startHeroAutoplay());
  }

  function renderCart(){
    // Drop any cart entries whose product (or variant) no longer exists —
    // e.g. the product was deleted from the admin panel. Without this,
    // such an entry silently skips rendering below (its row comes back as
    // '') but its qty still counts toward the cart badge, so the badge
    // shows a count with an empty panel behind it.
    Object.keys(cart).forEach(key => {
      if(!cartLineInfo(key)) delete cart[key];
    });
    saveCartToStorage();

    const keys = Object.keys(cart);
    const totalCount = keys.reduce((sum,key) => sum + cart[key].qty, 0);
    document.getElementById('cartCountTop').textContent = totalCount;
    const badge = document.getElementById('cartBadgeNav');
    if(totalCount > 0){ badge.style.display='flex'; badge.textContent = totalCount; }
    else { badge.style.display='none'; }

    const itemsEl = document.getElementById('cartItems');
    if(keys.length === 0){
      itemsEl.innerHTML = '<p class="cart-empty">Your cart is empty.<br>Add some gear to get rolling.</p>';
      document.getElementById('cartTotal').textContent = '₹0';
      return;
    }
    let total = 0;
    itemsEl.innerHTML = keys.map(key => {
      const info = cartLineInfo(key);
      if(!info) return '';
      const { product: p, variant, unitPrice, qty } = info;
      total += unitPrice * qty;
      const thumb = Array.isArray(p.images) && p.images.length ? p.images[0] : null;
      return `
      <div class="cart-row">
        <div class="cart-row-media">${thumb ? `<img src="${thumb}" alt="${p.name}">` : iconSvg}</div>
        <div class="cart-row-info">
          <p class="name">${p.name}</p>
          ${variant ? `<p class="cart-row-variant">${variant.name}</p>` : ''}
          <div class="qty-row">
            <button class="qty-btn" onclick="changeQty('${key}',-1)">−</button>
            <span class="qty-val">${qty}</span>
            <button class="qty-btn" onclick="changeQty('${key}',1)">+</button>
          </div>
        </div>
        <div class="cart-row-price">₹${(unitPrice*qty).toLocaleString('en-IN')}</div>
      </div>`;
    }).join('');
    document.getElementById('cartTotal').textContent = '₹' + total.toLocaleString('en-IN');
  }


  /* ---------------------------------------------------------------------
     SCROLL LOCK — reference counted.
     Overlays (lightbox, order popup) call lockScroll()/unlockScroll().
     A plain body{overflow:hidden} could stick around if the overlay went
     away by a different route, which froze the header in place. Counting
     the locks and clearing at zero makes that impossible.
     --------------------------------------------------------------------- */
  var _scrollLocks = 0;
  function lockScroll(){
    _scrollLocks++;
    document.body.style.overflow = "hidden";
  }
  function unlockScroll(){
    _scrollLocks = Math.max(0, _scrollLocks - 1);
    if(_scrollLocks === 0) document.body.style.overflow = "";
  }
  // safety net: if no overlay is actually open, the page must scroll
  function clearScrollLockIfIdle(){
    var anyOpen = [
      "lbOverlay", "orderResultOverlay", "pdpOverlay", "accountOverlay",
      "addressOverlay", "reviewOverlay", "shareOverlay", "checkoutOverlay",
      "authOverlay", "infoOverlay"
    ].some(function(id){
      var el = document.getElementById(id);
      return el && (el.classList.contains("open") || el.classList.contains("show"));
    });
    if(!anyOpen){
      _scrollLocks = 0;
      document.body.style.overflow = "";
    }
  }

  function showToast(msg){
    const t = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = msg;
    t.classList.add('show');
    clearTimeout(window._toastTimer);
    window._toastTimer = setTimeout(()=>t.classList.remove('show'), 1600);
  }

  // ---- Blinkit-style order result popup ----
  function showOrderResult(status, title, sub, opts){
    opts = opts || {};
    const overlay = document.getElementById('orderResultOverlay');
    const card = document.getElementById('orderResultCard');
    const icon = document.getElementById('orderResultIcon');
    document.getElementById('orderResultTitle').textContent = title;
    document.getElementById('orderResultSub').textContent = sub;
    card.classList.toggle('has-btn', !!opts.showButton);
    document.getElementById('orderResultBtn').textContent = opts.buttonText || 'OK';

    // restart animations every time it's shown
    icon.classList.remove('success','fail');
    void icon.offsetWidth; // force reflow so animation replays
    icon.classList.add(status);

    overlay.classList.add('show');
    lockScroll();

    clearTimeout(window._orderResultTimer);
    if(status === 'success' && !opts.showButton){
      window._orderResultTimer = setTimeout(closeOrderResult, opts.duration || 2200);
    }
  }
  function closeOrderResult(){
    document.getElementById('orderResultOverlay').classList.remove('show');
    unlockScroll();
    clearScrollLockIfIdle();
    clearTimeout(window._orderResultTimer);
  }
  document.getElementById('orderResultOverlay').addEventListener('click', (e)=>{
    if(e.target.id === 'orderResultOverlay') closeOrderResult();
