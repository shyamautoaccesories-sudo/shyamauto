  // ---- Checkout — step 2: place order in Supabase with the confirmed details ----
  document.getElementById('placeOrderBtn').addEventListener('click', async () => {
    const name = document.getElementById('coName').value.trim();
    const phone = document.getElementById('coPhone').value.trim();
    const addressLine = document.getElementById('coAddress').value.trim();
    const landmark = document.getElementById('coLandmark').value.trim();
    const city = document.getElementById('coCity').value.trim();
    const state = document.getElementById('coState').value.trim();
    const pincode = document.getElementById('coPincode').value.trim();
    if(!name || !/^\d{10}$/.test(phone) || !addressLine || !city || !state || !/^\d{6}$/.test(pincode)){
      document.getElementById('coError').classList.add('show');
      return;
    }
    const phoneWithCode = '+91' + phone;
    const address = `${addressLine}${landmark ? ', Near ' + landmark : ''}, ${city}, ${state} - ${pincode}`;
    let keys = Object.keys(cart);
    if(keys.length === 0){ showToast('Your cart is empty'); closeCheckoutFn(); return; }

    const btn = document.getElementById('placeOrderBtn');
    btn.disabled = true;

    // Final live-stock guard right before we start payment — closes the gap
    // between opening checkout and actually paying (someone else may have
    // just bought the last unit).
    btn.textContent = 'Checking stock...';
    await refreshLiveStock(cartProductIds());
    const stockChanges = reconcileCartWithStock();
    btn.textContent = 'Place Order';
    keys = Object.keys(cart);
    if(stockChanges.length){
      btn.disabled = false;
      document.getElementById('coError').classList.remove('show');
      refreshCodOptionUI();
      updateCheckoutTotals();
      showToast(stockChanges[0] + (stockChanges.length > 1 ? ` (+${stockChanges.length - 1} more update${stockChanges.length > 2 ? 's' : ''})` : ''));
      if(keys.length === 0) closeCheckoutFn();
      return;
    }

    const { data: { user } } = await sb.auth.getUser();
    const items = keys.map(key => {
      const info = cartLineInfo(key);
      return { product_id: info.product.id, name: info.variant ? `${info.product.name} — ${info.variant.name}` : info.product.name, variant: info.variant ? info.variant.name : null, qty: info.qty, price: info.unitPrice };
    });
    // Same line items, but with the raw variant index instead of the display
    // name — this is what the atomic decrement_stock() RPC needs to find
    // the right row/variant in the DB after payment succeeds.
    const stockItems = keys.map(key => {
      const line = cart[key];
      return { product_id: line.id, variant_index: line.variantIndex, qty: line.qty };
    });
    const subtotal = items.reduce((sum, it) => sum + it.price * it.qty, 0);
    const discountAmount = appliedCoupon ? appliedCoupon.discountAmount : 0;
    const deliveryCharge = keysDeliveryCharge();
    const isCod = selectedPaymentMethod() === 'Cash on Delivery' && cartCodEligible();
    const codCharge = isCod ? keysCodCharge() : 0;
    const combinedDeliveryCharge = deliveryCharge + codCharge;
    const total = Math.max(0, subtotal - discountAmount) + combinedDeliveryCharge;
    const advanceAmount = isCod ? Math.min(total, keysCodAdvance()) : 0;
    const couponCode = appliedCoupon ? appliedCoupon.code : null;

    async function markCouponUsed(){
      if(!appliedCoupon) return;
      try{ await sb.rpc('increment_discount_usage', { discount_id: appliedCoupon.id }); }
      catch(e){ /* non-fatal — order already placed */ }
    }

    async function afterStockDecrement(){
      let oversoldNotice = false;
      try{
        const { error: stockErr } = await sb.rpc('decrement_stock', { p_items: stockItems });
        if(stockErr){
          oversoldNotice = true;
          console.error('decrement_stock failed:', stockErr);
        } else {
          stockItems.forEach(it => {
            const p = findProduct(it.product_id);
            if(!p) return;
            if(it.variant_index != null && Array.isArray(p.variants) && p.variants[it.variant_index]){
              const v = p.variants[it.variant_index];
              if(v.stock != null) v.stock = Math.max(0, v.stock - it.qty);
            } else if(p.stock != null){
              p.stock = Math.max(0, p.stock - it.qty);
            }
          });
          renderStorefront();
        }
      }catch(e){ oversoldNotice = true; console.error(e); }
      return oversoldNotice;
    }

    // ---- Cash on Delivery (full) — no payment gateway involved, so the
    // order is inserted straight into `orders` and confirmed immediately. ----
    if(isCod && advanceAmount <= 0){
      btn.textContent = 'Placing order...';
      const { error: codErr } = await sb.from('orders').insert({
        user_id: user.id, customer_name: name, phone: phoneWithCode, address, city, state, pincode,
        items, total, coupon_code: couponCode, discount_amount: discountAmount,
        delivery_charge: combinedDeliveryCharge,
        payment_method: 'Cash on Delivery', payment_status: 'cod', status: 'Pending'
      });
      if(codErr){
        btn.disabled = false;
        btn.textContent = 'Place Order';
        showToast(codErr.message || 'Could not place order. Please try again.');
        return;
      }
      await markCouponUsed();
      const oversoldNotice = await afterStockDecrement();
      cart = {};
      saveCartToStorage();
      renderCart();
      resetCouponUI();
      btn.disabled = false;
      btn.textContent = 'Place Order';
      closeCheckoutFn();
      showOrderResult('success', 'Order Placed!', oversoldNotice
        ? 'Your Cash on Delivery order has been placed. One item had very limited stock — we will confirm availability and contact you if anything needs to change.'
        : `Your order has been placed. Pay ₹${total.toLocaleString('en-IN')} in cash when it's delivered.`);
      return;
    }

    // ---- Partial COD — part of the price is paid online via the payment
    // gateway now, and the rest is collected as cash on delivery. IMPORTANT:
    // the Razorpay order amount below is decided by your `create-razorpay-
    // order` Supabase Edge Function, not by this file. That function needs
    // a small update on your end so that when it receives payment_mode:
    // 'partial_cod', it looks up each product's own cod_advance_type /
    // cod_advance_value columns (never trust the client-sent advance_amount
    // for the actual charge — recompute it server-side) and creates the
    // Razorpay order for that advance amount instead of the full total.
    // verify-razorpay-payment similarly needs to save payment_status:
    // 'partial_cod' plus advance_paid_amount / cod_remaining_amount on the
    // order row. Until that edge-function change is made, this will still
    // charge the FULL order total online instead of just the advance.
    if(isCod && advanceAmount > 0){
      btn.textContent = 'Starting advance payment...';
      const remainingCodAmount = total - advanceAmount;
      const partialOrderPayload = {
        user_id: user.id, customer_name: name, phone: phoneWithCode, address, city, state, pincode,
        items, total, coupon_code: couponCode, discount_amount: discountAmount,
        delivery_charge: combinedDeliveryCharge,
        payment_method: 'Cash on Delivery (Partial Advance Paid)',
        payment_status: 'partial_cod',
        advance_paid_amount: advanceAmount,
        cod_remaining_amount: remainingCodAmount
      };
      try{
        const { data: createData, error: createErr } = await sb.functions.invoke('create-razorpay-order', {
          body: {
            items: items.map(it => ({ product_id: it.product_id, variant: it.variant, qty: it.qty })),
            coupon_code: couponCode,
            receipt: `sa_cod_${Date.now()}`,
            payment_mode: 'partial_cod',
            advance_amount: advanceAmount,
            customer: { user_id: user.id, customer_name: name, phone: phoneWithCode, address, city, state, pincode }
          }
        });
        if(createErr || !createData || createData.error){
          throw new Error(createData?.error || createErr?.message || 'Could not start advance payment');
        }

        const rzpOrder = createData.order;

        const rzp = new Razorpay({
          key: createData.key_id,
          amount: rzpOrder.amount,
          currency: rzpOrder.currency,
          name: 'Shyam Auto',
          description: `Advance payment — ₹${remainingCodAmount.toLocaleString('en-IN')} balance on delivery`,
          order_id: rzpOrder.id,
          prefill: { name, contact: phoneWithCode },
          theme: { color: '#f5a623' },
          handler: async function(response){
            btn.textContent = 'Confirming payment...';
            const { data: verifyData, error: verifyErr } = await sb.functions.invoke('verify-razorpay-payment', {
              body: {
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
                order: partialOrderPayload
              }
            });
            btn.disabled = false;
            btn.textContent = 'Place Order';
            if(verifyErr || !verifyData || !verifyData.verified || !verifyData.saved){
              closeCheckoutFn();
              showOrderResult('fail', 'Confirming your order…', 'Advance payment received! Your order is being confirmed and will appear shortly. If it doesn\'t show up in a few minutes, contact support with Payment ID: ' + response.razorpay_payment_id, { showButton:true, buttonText:'OK' });
              return;
            }
            await markCouponUsed();
            const oversoldNotice = await afterStockDecrement();
            cart = {};
            saveCartToStorage();
            renderCart();
            resetCouponUI();
            closeCheckoutFn();
            showOrderResult('success', 'Order Placed!', oversoldNotice
              ? 'Advance payment successful! Your order has been placed. One item had very limited stock — we will confirm availability and contact you if anything needs to change.'
              : `Advance payment of ₹${advanceAmount.toLocaleString('en-IN')} received. Pay the remaining ₹${remainingCodAmount.toLocaleString('en-IN')} in cash when it's delivered.`);
          },
          modal: {
            ondismiss: function(){
              btn.disabled = false;
              btn.textContent = 'Place Order';
              showToast('Payment cancelled');
            }
          }
        });
        rzp.on('payment.failed', function(){
          btn.disabled = false;
          btn.textContent = 'Place Order';
          closeCheckoutFn();
          showOrderResult('fail', 'Payment Failed', 'Something went wrong with your advance payment. Please try again.', { showButton:true, buttonText:'Try Again' });
        });
        rzp.open();
        btn.textContent = 'Place Order';
      }catch(err){
        btn.disabled = false;
        btn.textContent = 'Place Order';
        closeCheckoutFn();
        showOrderResult('fail', 'Order Failed', err.message || 'Something went wrong. Please try again.', { showButton:true, buttonText:'Try Again' });
      }
      return;
    }

    // ---- Online Payment (Razorpay) ----
    btn.textContent = 'Starting payment...';
    const orderPayload = { user_id: user.id, customer_name: name, phone: phoneWithCode, address, city, state, pincode, items, total, coupon_code: couponCode, discount_amount: discountAmount, delivery_charge: deliveryCharge };
    try{
      const { data: createData, error: createErr } = await sb.functions.invoke('create-razorpay-order', {
        body: {
          items: items.map(it => ({ product_id: it.product_id, variant: it.variant, qty: it.qty })),
          coupon_code: couponCode,
          receipt: `sa_${Date.now()}`,
          customer: { user_id: user.id, customer_name: name, phone: phoneWithCode, address, city, state, pincode }
        }
      });
      if(createErr || !createData || createData.error){
        throw new Error(createData?.error || createErr?.message || 'Could not start payment');
      }

      const rzpOrder = createData.order;

      const rzp = new Razorpay({
        key: createData.key_id,
        amount: rzpOrder.amount,
        currency: rzpOrder.currency,
        name: 'Shyam Auto',
        description: 'Order payment',
        order_id: rzpOrder.id,
        prefill: { name, contact: phoneWithCode },
        theme: { color: '#f5a623' },
        handler: async function(response){
          btn.textContent = 'Confirming payment...';
          const { data: verifyData, error: verifyErr } = await sb.functions.invoke('verify-razorpay-payment', {
            body: {
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              order: orderPayload
            }
          });
          btn.disabled = false;
          btn.textContent = 'Place Order';
          if(verifyErr || !verifyData || !verifyData.verified || !verifyData.saved){
            closeCheckoutFn();
            showOrderResult('fail', 'Confirming your order…', 'Payment received! Your order is being confirmed and will appear shortly. If it doesn\'t show up in a few minutes, contact support with Payment ID: ' + response.razorpay_payment_id, { showButton:true, buttonText:'OK' });
            return;
          }
          await markCouponUsed();
          // Order is confirmed & paid — now atomically decrement real stock
          // in the DB. This runs as a single-transaction Postgres function
          // (decrement_stock) so concurrent orders on the same product can
          // never oversell it, even if two customers both got this far at
          // the same time. See the SQL provided alongside this file.
          let oversoldNotice = false;
          try{
            const { error: stockErr } = await sb.rpc('decrement_stock', { p_items: stockItems });
            if(stockErr){
              // Extremely rare: stock ran out in the split second between
              // our pre-payment check and this call. Order + payment are
              // already valid, so we don't roll anything back — we just
              // flag it so support can follow up (same policy already
              // promised on the FAQ page).
              oversoldNotice = true;
              console.error('decrement_stock failed after payment:', stockErr);
            } else {
              // Reflect the new stock locally immediately, so the storefront
              // shows "Out of stock" without needing a page reload.
              stockItems.forEach(it => {
                const p = findProduct(it.product_id);
                if(!p) return;
                if(it.variant_index != null && Array.isArray(p.variants) && p.variants[it.variant_index]){
                  const v = p.variants[it.variant_index];
                  if(v.stock != null) v.stock = Math.max(0, v.stock - it.qty);
                } else if(p.stock != null){
                  p.stock = Math.max(0, p.stock - it.qty);
                }
              });
              renderStorefront();
            }
          }catch(e){ oversoldNotice = true; console.error(e); }
          cart = {};
          saveCartToStorage();
          renderCart();
          resetCouponUI();
          closeCheckoutFn();
          showOrderResult('success', 'Order Placed!', oversoldNotice
            ? 'Payment successful! Your order has been placed. One item had very limited stock — we will confirm availability and contact you if anything needs to change.'
            : 'Payment successful! Your order has been placed.');
        },
        modal: {
          ondismiss: function(){
            btn.disabled = false;
            btn.textContent = 'Place Order';
            showToast('Payment cancelled');
          }
        }
      });
      rzp.on('payment.failed', function(){
        btn.disabled = false;
        btn.textContent = 'Place Order';
        closeCheckoutFn();
        showOrderResult('fail', 'Payment Failed', 'Something went wrong with your payment. Please try again.', { showButton:true, buttonText:'Try Again' });
      });
      rzp.open();
      btn.textContent = 'Place Order';
    }catch(err){
      btn.disabled = false;
      btn.textContent = 'Place Order';
      closeCheckoutFn();
      showOrderResult('fail', 'Order Failed', err.message || 'Something went wrong. Please try again.', { showButton:true, buttonText:'Try Again' });
    }
  });

  // ---- Store traffic tracking (self-hosted, no third-party tool) ----
  // Records one row per browser session so Admin → Analytics can show real
  // visit counts and referrer sources. Fails silently if the `page_views`
  // table hasn't been created yet — never blocks or slows down the storefront.
  function trackPageView(){
    try{
      let sessionId = localStorage.getItem('sa_session_id');
      if(!sessionId){
        sessionId = 'sess_' + Date.now() + '_' + Math.random().toString(36).slice(2,10);
        localStorage.setItem('sa_session_id', sessionId);
      }
      const seenKey = 'sa_session_view_logged';
      if(sessionStorage.getItem(seenKey)) return; // only once per browser session
      sessionStorage.setItem(seenKey, '1');
      sb.from('page_views').insert({
        session_id: sessionId,
        path: window.location.pathname,
        referrer: document.referrer || null
      }).then(() => {}, () => {});
    }catch(e){ /* tracking should never break the storefront */ }
  }

  // ---- Kick everything off ----
  (async () => {
    site = await loadSiteContent();
    renderStorefront();
    trackPageView();

    // Deep links from the header on other pages (About Us, Policies, etc.) —
    // tapping Search or Cart there sends the shopper here with a flag so the
    // matching overlay opens as soon as the storefront has loaded.
    const headerParams = new URLSearchParams(window.location.search);
    if(headerParams.get('openSearch') === '1') openSearch();
    if(headerParams.get('openCart') === '1') openCart();

    // ---- Shared product link: ?product=<id> (or #product=<id>) ----
    // Someone tapped a link shared from the Share button, so open that
    // product's page straight away instead of dropping them on the home feed.
    openSharedProductFromUrl();
  })();
</script>
