  const priceBuckets = [
    { key: 'u500', label: 'Under ₹500', min: 0, max: 500 },
    { key: '500-1000', label: '₹500 – ₹1,000', min: 500, max: 1000 },
    { key: '1000-2500', label: '₹1,000 – ₹2,500', min: 1000, max: 2500 },
