        <span class="plate"><span class="price">${priceInfo.hasVariants ? 'From ' : ''}₹${priceInfo.price.toLocaleString('en-IN')}</span>${showMrp ? `<span class="mrp">₹${priceInfo.mrp.toLocaleString('en-IN')}</span>` : ''}</span>
