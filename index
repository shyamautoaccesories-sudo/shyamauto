  function pdpChangeQty(delta){
    const p = findProduct(pdpCurrentId);
    if(!p) return;
    const v = (pdpSelectedVariantIndex != null && Array.isArray(p.variants)) ? p.variants[pdpSelectedVariantIndex] : null;
    const maxQty = v ? (v.stock != null ? v.stock : Infinity) : (p.stock != null ? p.stock : Infinity);
    const newQty = pdpQty + delta;
    if(delta > 0 && newQty > maxQty){
      // Surface it in the product view as well — the toast disappears fast.
      var note = document.getElementById('pdpStockNote');
      var noteText = document.getElementById('pdpStockNoteText');
      if(note && noteText && maxQty !== Infinity){
        note.className = 'pdp-stock-note show warn';
        noteText.innerHTML = '<strong>Only ' + maxQty + ' available.</strong> Aap ' + maxQty + ' se zyada nahi le sakte.';
      }
      showToast(`Only ${maxQty} in stock for this product`);
      return;
    }
    pdpQty = Math.max(1, newQty);
    document.getElementById('pdpQty').textContent = pdpQty;
  }
