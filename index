  function renderThreadMessages(){
    const msgs = Array.isArray(activeTicket.messages) ? activeTicket.messages : [];
    // The most recent photo batch belongs to the newest customer message.
    const allImgs = Array.isArray(activeTicket.images) ? activeTicket.images : [];
    const recentImgs = (activeTicket.images_expire_at && allImgs.length) ? allImgs.slice(-3) : [];
    document.getElementById('chatThreadMessages').innerHTML = msgs.map((m, idx) => `
      <div class="chat-bubble from-${m.sender === 'admin' ? 'admin' : 'customer'}">
        ${m.text.replace(/</g,'&lt;')}
        ${(idx === msgs.length - 1 && recentImgs.length) ? `<div class="tk-thread-photos" style="margin-top:7px;">${recentImgs.map((u,k) => `<img src="${u}" style="width:56px;height:56px;" onclick="openLightbox(${JSON.stringify(recentImgs).replace(/"/g,"&quot;")}, ${k})">`).join('')}</div>` : ''}
        <span class="chat-bubble-time">${new Date(m.at).toLocaleString('en-IN', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})}</span>
      </div>
    `).join('');
  }

  function closeTicketThread(){
    resetReplyPhotos();
    const wasOpen = document.getElementById('chatThreadView').style.display === 'block';
    document.getElementById('chatThreadView').style.display = 'none';
    document.getElementById('chatMineList').style.display = 'block';
